@using TrafagSalesExporter.Services
@inject IUiTextService UiText

@* Zustand der externen Quellen (2026-10-05). „Firewall blockiert“ heisst: vom Server aus nicht erreichbar. *@
<MudPaper Class="pa-3" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">@T("Quellen", "Sources")</MudText>
    @foreach (var s in Sources)
    {
        <div class="wl-src">
            <span class="wl-src-dot wl-src-@s.State.ToString().ToLowerInvariant()"></span>
            <div class="ll-grow">
                <div><b>@s.Name</b> <span class="ll-muted ll-mono">@s.Host</span></div>
                <div class="ll-muted" style="font-size:12px">
                    @StateText(s.State)@(string.IsNullOrEmpty(s.Message) ? "" : " · " + s.Message)
                    @if (s.FetchedAtUtc is { } at)
                    {
                        <span> · @at.ToLocalTime().ToString("dd.MM. HH:mm")</span>
                    }
                </div>
            </div>
        </div>
    }
    @if (Exposure?.SalesError is { } se)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@T("Verkauf nicht lesbar", "Sales not readable"): @se</MudAlert>
    }
    @if (Exposure?.PurchasingError is { } pe)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@T("Einkauf nicht lesbar", "Purchasing not readable"): @pe</MudAlert>
    }
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<WorldSourceStatus> Sources { get; set; } = [];
    [Parameter] public WorldExposure? Exposure { get; set; }

    private string StateText(WorldSourceState state) => state switch
    {
        WorldSourceState.Ok => T("verbunden", "connected"),
        WorldSourceState.Blocked => T("Firewall blockiert", "blocked by firewall"),
        WorldSourceState.Error => T("Fehler", "error"),
        _ => T("ausstehend", "pending")
    };

    private string T(string german, string english) => UiText.Text(german, english);
}
