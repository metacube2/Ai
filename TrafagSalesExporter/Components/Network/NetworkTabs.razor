@using TrafagSalesExporter.Services
@inject NavigationManager Nav
@inject IUiTextService UiText

@* Unterreiter des Reiters Netzwerk (2026-10-02). Doku: docs/NETZWERK_2026-10-02.md *@
<div class="nw-tabs">
    @foreach (var tab in Tabs)
    {
        <a href="@tab.Href" class="nw-tab @(IsActive(tab.Href) ? "nw-tab-active" : string.Empty)">
            <MudIcon Icon="@tab.Icon" Size="Size.Small" />
            <span>@tab.Label</span>
        </a>
    }
</div>

@code {
    private sealed record Tab(string Href, string Icon, string Label);

    private IReadOnlyList<Tab> Tabs =>
    [
        new("netzwerk", Icons.Material.Filled.Hub, T("Übersicht", "Overview")),
        new("netzwerk/verfuegbarkeit", Icons.Material.Filled.Timeline, T("Verfügbarkeit", "Availability")),
        new("netzwerk/netz-oder-daten", Icons.Material.Filled.CompareArrows, T("Netz oder Daten", "Network or data")),
        new("netzwerk/sicherheit", Icons.Material.Filled.Security, T("Sicherheit", "Security")),
        new("netzwerk/ad", Icons.Material.Filled.Domain, T("Active Directory", "Active Directory")),
        new("netzwerk/arbeitsplaetze", Icons.Material.Filled.Wifi, T("Arbeitsplätze", "Workplaces"))
    ];

    private bool IsActive(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
    }

    private string T(string german, string english) => UiText.Text(german, english);
}
