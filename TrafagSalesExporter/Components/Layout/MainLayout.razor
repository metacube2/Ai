@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@inject TrafagSalesExporter.Services.IUiTextService UiText
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Kein Color="Color.Primary": das nimmt im Dunkelmodus das helle Schaltflaechen-Rot.
       Ohne Color gilt AppbarBackground der jeweiligen Palette (hell #B71C1C, dunkel #7F1D1D). *@
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3 app-title">@T("Trafag Cockpit", "Trafag Cockpit")</MudText>
        <MudSpacer />
        @* Statusampel: haelt die Meldungen fest, die sonst mit der Snackbar verschwinden.
           Bewusst hier oben und nicht auf einer Seite, damit der Zustand ueberall sichtbar
           ist. Siehe Components/AppStatusLight.razor. *@
        <AppStatusLight />
        <MudTooltip Text="@T("Hell/Dunkel umschalten", "Switch light/dark")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkModeAsync" Class="mr-1" />
        </MudTooltip>
        <MudMenu Class="mr-3 language-menu"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Dense>
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Translate"
                           EndIcon="@Icons.Material.Filled.ExpandMore"
                           Class="language-button">
                    @LanguageLabel
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => ChangeLanguage("de"))">Deutsch</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("en"))">English</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("es"))">Español</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("it"))">Italiano</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("hi"))">हिन्दी</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("sq"))">Shqip</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("tr"))">Türkçe</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChangeLanguage("tlh"))">tlhIngan Hol</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <AuthorizeView>
            <Authorized Context="authState">
                <MudText Typo="Typo.caption" Class="mr-3">@ShortName(authState.User)</MudText>
            </Authorized>
        </AuthorizeView>
        <img src="trafag.jpg" alt="Trafag" class="app-logo" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    @* Bewusst kein `pa-4`: die MudBlazor-Hilfsklasse setzt `padding` mit `!important` und
       ueberschreibt damit den Abstand, den MudBlazor fuer die fest positionierte Kopfleiste
       vergibt. Der Seitenkopf lag dadurch auf jeder Seite unter der Kopfleiste und war
       unsichtbar. Oben deshalb nichts setzen, seitlich und unten weiterhin `4`. *@
    <MudMainContent Class="px-4 pb-4" @key="UiText.CurrentLanguage">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    // Standard ist dunkel (Wunsch Ingo 2026-09-29); hell nur, wenn im Browser so gewaehlt.
    private bool _isDarkMode = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#B71C1C",
            Secondary = "#7F1D1D",
            AppbarBackground = "#B71C1C"
        },
        // Dunkel: gedaempftes Trafag-Rot in der Kopfleiste, helleres Rot fuer Schaltflaechen
        // und Links, damit sie auf dem dunklen Grund lesbar bleiben.
        PaletteDark = new PaletteDark
        {
            Primary = "#EF5350",
            Secondary = "#E57373",
            AppbarBackground = "#7F1D1D",
            Background = "#1E1F25",
            Surface = "#272830",
            DrawerBackground = "#22232A",
            DrawerText = "rgba(255,255,255,0.80)",
            TextPrimary = "rgba(255,255,255,0.87)",
            TextSecondary = "rgba(255,255,255,0.62)"
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Gemerkte Wahl je Browser; ohne Wahl bleibt es dunkel.
        var dark = await JS.InvokeAsync<string?>("trafagTheme.get") != "light";

        if (dark != _isDarkMode)
        {
            _isDarkMode = dark;
            StateHasChanged();
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("trafagTheme.set", _isDarkMode ? "dark" : "light");
    }

    protected override void OnInitialized()
    {
        UiText.Changed += HandleLanguageChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ChangeLanguage(string language)
    {
        UiText.SetLanguage(language);
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string LanguageLabel => UiText.CurrentLanguage.ToUpperInvariant();

    private string T(string german, string english) => UiText.Text(german, english);

    private static string ShortName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name ?? string.Empty;
        var separator = name.LastIndexOf('\\');
        return separator >= 0 && separator < name.Length - 1 ? name[(separator + 1)..] : name;
    }

    public void Dispose()
    {
        UiText.Changed -= HandleLanguageChanged;
    }
}
