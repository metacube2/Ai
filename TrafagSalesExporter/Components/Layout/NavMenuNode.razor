@using TrafagSalesExporter.Models
@using TrafagSalesExporter.Services
@using Microsoft.AspNetCore.Components.Routing

@if (Item.ItemType == NavigationMenuItemTypes.Group)
{
    <MudNavGroup Title="@Title" Icon="@Icon" Expanded="@Item.IsExpanded" Class="@LinkClass">
        @foreach (var child in Children)
        {
            <NavMenuNode Item="child"
                         Items="Items"
                         HiddenKeys="HiddenKeys"
                         OnAction="OnAction" />
        }
    </MudNavGroup>
}
else if (Item.ItemType == NavigationMenuItemTypes.Action)
{
    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
               StartIcon="@Icon" OnClick="() => OnAction.InvokeAsync(Item.Key)" Class="ml-3">
        @Title
    </MudButton>
}
else
{
    <MudNavLink Href="@Item.Href" Match="@Match" Icon="@Icon" Class="@LinkClass">
        @Title
    </MudNavLink>
}

@code {
    [Parameter, EditorRequired] public NavigationMenuItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<NavigationMenuItem> Items { get; set; } = [];
    [Parameter] public HashSet<string> HiddenKeys { get; set; } = [];
    [Parameter] public EventCallback<string> OnAction { get; set; }

    private string Title => UiText.Text(Item.TitleDe, Item.TitleEn);
    private string Icon => NavigationIconResolver.Resolve(Item.Icon);
    private NavLinkMatch Match => string.Equals(Item.Match, "All", StringComparison.OrdinalIgnoreCase)
        ? NavLinkMatch.All
        : NavLinkMatch.Prefix;

    // Hervorgehobene Eintraege (Wunsch Ingo 2026-10-13): rot, weisse fette Schrift, animiert. CSS .nav-hl in app.css.
    // 2026-10-16 (Wunsch Ingo): alle Hauptbereiche farbig, je ein eigener gedeckter Rotton (nav-hl-r1..r5, Nachmittag dezenter), Admin grau, Home pulsiert.
    private static readonly Dictionary<string, string> Highlighted = "management-home=nav-hl nav-hl-home;projects=nav-hl;operations=nav-hl;network=nav-hl nav-hl-net;trafag-reddit=nav-hl nav-hl-orange;user-manual=nav-hl-grey;finance=nav-hl nav-hl-r1;hr=nav-hl nav-hl-r2;purchasing=nav-hl nav-hl-r3;sales=nav-hl nav-hl-r4;logistics=nav-hl nav-hl-r5;finance-admin=nav-hl-grey nav-hl-admin".Split(';').Select(x => x.Split('=')).ToDictionary(x => x[0], x => x[1], StringComparer.OrdinalIgnoreCase);
    private string? LinkClass => Highlighted.GetValueOrDefault(Item.Key);

    [Inject] private IUiTextService UiText { get; set; } = default!;

    private IEnumerable<NavigationMenuItem> Children => Items
        .Where(x => x.IsVisible)
        .Where(x => !HiddenKeys.Contains(x.Key))
        .Where(x => string.Equals(x.ParentKey, Item.Key, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.TitleDe);
}
