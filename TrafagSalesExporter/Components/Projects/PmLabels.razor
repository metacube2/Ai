@* Uebersetzte Namen fuer Typen, Prioritaeten, Spaltenarten, Vorlagen und Sprintstatus (nur statische Hilfen).
   Als .razor-Datei, damit der Uebersetzungstest die Textpaare findet. *@
@code {
    public static string Type(IUiTextService ui, string type) => type switch
    {
        "Story" => ui.Text("Story", "Story"),
        "Bug" => ui.Text("Fehler", "Bug"),
        "Epic" => ui.Text("Epic", "Epic"),
        "Subtask" => ui.Text("Unteraufgabe", "Subtask"),
        _ => ui.Text("Aufgabe", "Task")
    };

    public static string Priority(IUiTextService ui, string priority) => priority switch
    {
        "Highest" => ui.Text("Sehr hoch", "Highest"),
        "High" => ui.Text("Hoch", "High"),
        "Low" => ui.Text("Niedrig", "Low"),
        "Lowest" => ui.Text("Sehr niedrig", "Lowest"),
        _ => ui.Text("Mittel", "Medium")
    };

    public static string Category(IUiTextService ui, string category) => category switch
    {
        "InProgress" => ui.Text("In Arbeit", "In progress"),
        "Done" => ui.Text("Erledigt", "Done"),
        _ => ui.Text("Offen", "To do")
    };

    // HERMES (2026-10-13): Stufe, Ampel, Phase und Entscheidungspunkte.
    public static string Stage(IUiTextService ui, string stage) => stage switch
    {
        "SmallOrder" => ui.Text("Kleinauftrag", "Small order"),
        "Undertaking" => ui.Text("Vorhaben", "Undertaking"),
        "Project" => ui.Text("Projekt", "Project"),
        _ => ui.Text("Nicht eingestuft", "Not classified")
    };

    public static string StageHelp(IUiTextService ui, string stage) => stage switch
    {
        "SmallOrder" => ui.Text("Unter etwa 5 Personentagen. Ein Ticket genügt, es braucht keine HERMES-Dokumente.", "Under about 5 person-days. A ticket is enough, no HERMES documents are needed."),
        "Undertaking" => ui.Text("Etwa 5 bis 40 Personentage. Es braucht einen Projektauftrag, eine Abnahme und eine Statuszeile.", "About 5 to 40 person-days. It needs a project order, an acceptance and a status line."),
        "Project" => ui.Text("Über etwa 40 Personentage. HERMES zugeschnitten mit Risikoliste, eventuell mit Ausschuss.", "Over about 40 person-days. Tailored HERMES with a risk list, possibly a steering board."),
        _ => ui.Text("Die Stufe richtet sich nach dem geschätzten Aufwand.", "The level follows the estimated effort.")
    };

    public static string Traffic(IUiTextService ui, string traffic) => traffic switch
    {
        "Green" => ui.Text("Grün: läuft nach Plan", "Green: on track"),
        "Yellow" => ui.Text("Gelb: Verzug oder offene Frage", "Yellow: delay or open question"),
        "Red" => ui.Text("Rot: braucht einen Entscheid", "Red: needs a decision"),
        _ => ui.Text("Keine Ampel gesetzt", "No status set")
    };

    public static string Phase(IUiTextService ui, string phase) => phase switch
    {
        "Execution" => ui.Text("Umsetzung", "Execution"),
        "Introduction" => ui.Text("Einführung", "Introduction"),
        "Closed" => ui.Text("Abgeschlossen", "Closed"),
        _ => ui.Text("Initialisierung", "Initiation")
    };

    public static string PhaseHelp(IUiTextService ui, string phase) => phase switch
    {
        "Execution" => ui.Text("Nach der Freigabe: Die Arbeit läuft, Ampel und Statuszeile halten die Geschäftsleitung auf dem Laufenden.", "After the release: the work is under way, status light and status line keep management informed."),
        "Introduction" => ui.Text("Nach der Abnahme: Übergabe in den Betrieb mit Dokumentation und Zuständigkeit.", "After acceptance: handover to operations with documentation and ownership."),
        "Closed" => ui.Text("Nach dem Abschluss: Das Vorhaben ist fertig und im Betrieb.", "After closure: the undertaking is finished and in operation."),
        _ => ui.Text("Vor der Freigabe: Projektauftrag schreiben, Rollen und Abnahmekriterien festlegen.", "Before the release: write the project order, define roles and acceptance criteria.")
    };

    public static string Milestone(IUiTextService ui, int number) => number switch
    {
        1 => ui.Text("Freigabe", "Release"),
        2 => ui.Text("Abnahme", "Acceptance"),
        _ => ui.Text("Abschluss", "Closure")
    };

    public static string MilestoneHelp(IUiTextService ui, int number) => number switch
    {
        1 => ui.Text("Der Auftraggeber unterschreibt den Projektauftrag.", "The sponsor signs the project order."),
        2 => ui.Text("Der Anwendervertreter unterschreibt das Abnahmeprotokoll.", "The user representative signs the acceptance record."),
        _ => ui.Text("Die Übergabe in den Betrieb ist erledigt.", "The handover to operations is done.")
    };

    public static string Template(IUiTextService ui, string template) => template switch
    {
        "Scrum" => ui.Text("Scrum mit Sprints", "Scrum with sprints"),
        "Planner" => ui.Text("Planner mit Buckets", "Planner with buckets"),
        _ => ui.Text("Kanban-Board", "Kanban board")
    };

    public static string TemplateHelp(IUiTextService ui, string template) => template switch
    {
        "Scrum" => ui.Text("Wie Jira: Backlog, Sprints mit Ziel, Story Points und Burndown.", "Like Jira: backlog, sprints with a goal, story points and burndown."),
        "Planner" => ui.Text("Wie Microsoft Planner: Buckets, Checklisten, Diagramme, Fortschritt.", "Like Microsoft Planner: buckets, checklists, charts, progress."),
        _ => ui.Text("Wie Trello: Listen, Karten ziehen, Farben und Labels.", "Like Trello: lists, drag cards, colours and labels.")
    };

    public static string SprintState(IUiTextService ui, string state) => state switch
    {
        "Active" => ui.Text("Läuft", "Active"),
        "Closed" => ui.Text("Abgeschlossen", "Closed"),
        _ => ui.Text("Geplant", "Planned")
    };

    /// <summary>Relative Faelligkeit: heute, morgen, in drei Tagen oder seit zwei Tagen ueberfaellig.</summary>
    public static string Due(IUiTextService ui, DateTime due)
    {
        var days = (due.Date - DateTime.Today).Days;
        return days switch
        {
            0 => ui.Text("heute", "today"),
            1 => ui.Text("morgen", "tomorrow"),
            > 1 => string.Format(ui.Text("in {0} Tagen", "in {0} days"), days),
            -1 => ui.Text("seit gestern überfällig", "overdue since yesterday"),
            _ => string.Format(ui.Text("seit {0} Tagen überfällig", "overdue for {0} days"), -days)
        };
    }
}
