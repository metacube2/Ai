@using TrafagSalesExporter.Services
@inject NavigationManager Nav
@inject IUiTextService UiText

@* Unterreiter des Reiters Verkauf (2026-10-02). Doku: docs/VERKAUF_2026-10-02.md *@
<div class="nw-tabs">
    @foreach (var tab in Tabs)
    {
        <a href="@tab.Href" class="nw-tab @(IsActive(tab.Href) ? "nw-tab-active" : string.Empty)">
            <MudIcon Icon="@tab.Icon" Size="Size.Small" />
            <span>@tab.Label</span>
        </a>
    }
</div>

@code {
    private sealed record Tab(string Href, string Icon, string Label);

    private IReadOnlyList<Tab> Tabs =>
    [
        new("verkauf", Icons.Material.Filled.Storefront, T("Kunden", "Customers")),
        new("verkauf/rueckgang", Icons.Material.Filled.TrendingDown, T("Rückgang", "Decline")),
        new("verkauf/kundenbewegung", Icons.Material.Filled.SwapVert, T("Neue und verlorene Kunden", "New and lost customers")),
        new("verkauf/konzentration", Icons.Material.Filled.PieChart, T("Konzentration", "Concentration")),
        new("verkauf/cross-selling", Icons.Material.Filled.JoinInner, T("Cross-Selling", "Cross-selling")),
        new("verkauf/preise", Icons.Material.Filled.PriceChange, T("Preisstreuung", "Price spread")),
        new("verkauf/prognose", Icons.Material.Filled.QueryStats, T("Saison und Prognose", "Season and forecast")),
        new("verkauf/weltkarte", Icons.Material.Filled.Public, T("Weltkarte", "World map"))
    ];

    private bool IsActive(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
    }

    private string T(string german, string english) => UiText.Text(german, english);
}
