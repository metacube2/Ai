@using System.Globalization
@using TrafagSalesExporter.Services
@using static TrafagSalesExporter.Components.Sales.SalesUi
@implements IDisposable
@inject IUiTextService UiText

@* Verkauf Interaktiv: Kunden-Galaxie im Gapminder-Stil (2026-10-05). Blasen gleiten über CSS-Übergänge von Quartal zu Quartal. *@
<MudPaper Class="pa-3" Outlined="true">
    <div class="d-flex align-center flex-wrap" style="gap:12px">
        <MudText Typo="Typo.h6" Class="ll-grow">@T("Kunden-Galaxie", "Customer galaxy")</MudText>
        <MudIconButton Icon="@(_playing ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="TogglePlay" />
        <span class="ll-mono" style="min-width:90px">@QuarterLabel</span>
        <MudSlider T="int" Min="0" Max="@(Math.Max(0, _frames.Count - 1))" Value="_frame" ValueChanged="SetFrame" Style="max-width:260px" />
        <MudSwitch T="bool" @bind-Value="_trails" Color="Color.Primary" Label="@T("Spuren", "Trails")" />
    </div>
    @if (_frames.Count == 0)
    {
        <MudText Class="ll-muted">@T("Zu wenig Daten.", "Not enough data.")</MudText>
    }
    else
    {
        var f = _frames[_frame];
        <svg viewBox="0 0 1000 560" class="six-galaxy">
            @foreach (var gx in new[] { 0.0, 0.25, 0.5, 0.75, 1.0 })
            {
                <line x1="@F(60 + gx * 920)" y1="20" x2="@F(60 + gx * 920)" y2="510" class="six-grid" />
            }
            @foreach (var g in new[] { -100, 0, 100, 200, 300 })
            {
                <line x1="60" y1="@F(Y(g))" x2="980" y2="@F(Y(g))" class="six-grid @(g == 0 ? "six-zero" : "")" />
                <g><text x="52" y="@F(Y(g) + 4)" class="nw-axis" style="text-anchor:end">@(g > 0 ? "+" : "")@g %</text></g>
            }
            <text x="520" y="545" class="nw-axis">@T("Umsatz im Quartal (logarithmisch)", "Revenue in quarter (logarithmic)")</text>
            <text x="14" y="270" class="nw-axis" transform="rotate(-90 14 270)">@T("Veränderung zum Vorquartal", "Change vs previous quarter")</text>
            <text x="980" y="500" class="six-watermark" style="text-anchor:end">@QuarterLabel</text>
            @if (_trails && _selected is not null)
            {
                <polyline points="@Trail(_selected)" class="six-trail" />
            }
            @foreach (var p in f.Points.OrderByDescending(p => p.Invoices))
            {
                var sel = _selected == p.Key;
                var dim = _selected is not null && !sel;
                <circle class="six-bubble @(sel ? "six-sel" : "") @(dim ? "six-dim" : "")"
                        style="cx:@F(X(p.Revenue))px;cy:@F(Y(p.Growth))px;r:@F(R(p.Invoices))px;fill:@CountryColor(p.Country)"
                        @onclick="@(() => _selected = sel ? null : p.Key)">
                    <title>@p.Name (@p.Country): CHF @Chf(p.Revenue), @(p.Growth.ToString("+0;-0", CultureInfo.InvariantCulture)) %, @p.Invoices @T("Rechnungen", "invoices")</title>
                </circle>
                @if (sel || R(p.Invoices) > 16)
                {
                    <g><text x="@F(X(p.Revenue))" y="@F(Y(p.Growth) - R(p.Invoices) - 4)" class="six-label">@Cut(p.Name)</text></g>
                }
            }
        </svg>
        <MudText Typo="Typo.caption" Class="ll-muted d-block">@T("Jede Blase ist einer der 60 grössten Kunden der letzten 12 Monate. Rechts = mehr Umsatz im Quartal, oben = Wachstum gegen das Vorquartal, Grösse = Rechnungen, Farbe = Land. ▶ spielt die Quartale ab; Klick auf eine Blase hebt den Kunden hervor, mit Spuren sieht man seinen Weg.", "Each bubble is one of the 60 largest customers of the last 12 months. Right = more revenue in the quarter, up = growth vs previous quarter, size = invoices, colour = country. ▶ plays the quarters; click a bubble to highlight the customer, with trails you see its path.")</MudText>
    }
</MudPaper>

@code {
    [Parameter] public SalesDataset Data { get; set; } = default!;

    private IReadOnlyList<GalaxyFrame> _frames = [];
    private int _frame;
    private bool _playing;
    private bool _trails = true;
    private string? _selected;
    private double _logMin, _logMax;
    private CancellationTokenSource? _play;
    private static readonly string[] Palette = "#F08A4B #4FC3F7 #81C784 #BA68C8 #FFD54F #E57373 #4DB6AC #9575CD #AED581 #FF8A65 #90A4AE #F06292".Split(' ');
    private readonly Dictionary<string, string> _colors = [];

    protected override void OnParametersSet()
    {
        _frames = SalesInteractive.Galaxy(Data.Facts, Data.ReferenceEnd, Data.DataStart);
        var values = _frames.SelectMany(f => f.Points).Select(p => (double)p.Revenue).Where(v => v > 0).ToList();
        _logMin = Math.Log10(Math.Max(100, values.DefaultIfEmpty(1000).Min()));
        _logMax = Math.Log10(Math.Max(1000, values.DefaultIfEmpty(1000000).Max()));
        _frame = Math.Max(0, _frames.Count - 1);
    }

    private string QuarterLabel => _frames.Count == 0 ? "" : $"Q{(_frames[_frame].Quarter.Month - 1) / 3 + 1} {_frames[_frame].Quarter.Year}";

    private double X(decimal revenue) => revenue <= 0 ? 60 : 60 + 920 * Math.Clamp((Math.Log10((double)revenue) - _logMin) / Math.Max(0.1, _logMax - _logMin), 0, 1);
    private static double Y(double growth) => 510 - (Math.Clamp(growth, -100, 300) + 100) / 400 * 490;
    private static double R(int invoices) => invoices <= 0 ? 2 : 4 + 3 * Math.Sqrt(invoices);
    private static string Cut(string s) => s.Length > 22 ? s[..21] + "…" : s;

    private string CountryColor(string country)
    {
        if (!_colors.TryGetValue(country, out var c))
            _colors[country] = c = Palette[_colors.Count % Palette.Length];
        return c;
    }

    private string Trail(string key)
        => string.Join(" ", _frames.Take(_frame + 1).Select(f => f.Points.FirstOrDefault(p => p.Key == key)).OfType<GalaxyPoint>()
            .Select(p => $"{F(X(p.Revenue))},{F(Y(p.Growth))}"));

    private void SetFrame(int v) => _frame = v;

    private void TogglePlay()
    {
        if (_playing) { _play?.Cancel(); _playing = false; return; }
        _playing = true;
        if (_frame >= _frames.Count - 1) _frame = 0;
        _play = new CancellationTokenSource();
        var token = _play.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(1100));
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                if (_frame >= _frames.Count - 1) { _playing = false; await InvokeAsync(StateHasChanged); return; }
                _frame++;
                await InvokeAsync(StateHasChanged);
            }
        }, token).ContinueWith(_ => { }, TaskScheduler.Default);
    }

    public void Dispose() { _play?.Cancel(); _play?.Dispose(); }

    private string T(string german, string english) => UiText.Text(german, english);
}
