@page "/verkauf/prognose"
@rendermode @(Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer)
@using TrafagSalesExporter.Services
@using TrafagSalesExporter.Components.Sales
@using TrafagSalesExporter.Components.Network
@using static TrafagSalesExporter.Components.Sales.SalesUi
@inject SalesDataService Sales
@inject IUiTextService UiText

@* Reiter Verkauf, Saisonalitaet und Prognose je Sparte und Gesellschaft (2026-10-02). Doku docs/VERKAUF_2026-10-02.md *@
<PageTitle>@T("Verkauf", "Sales") · @T("Saison und Prognose", "Season and forecast")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@T("Verkauf", "Sales")</MudText>
<SalesTabs />

@if (_data is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_data.Error is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true">@_data.Error</MudAlert>
}
else if (_f is not null)
{
    <div class="d-flex align-center flex-wrap mb-2" style="gap:12px">
        <MudSelect T="string" Value="_dimension" ValueChanged="Choose" Label="@T("Sicht", "View")" Dense="true" Variant="Variant.Outlined" Style="max-width:320px">
            @foreach (var d in _dimensions)
            {
                <MudSelectItem T="string" Value="@d">@Label(d)</MudSelectItem>
            }
        </MudSelect>
        <ExcelButton FileLabel="Verkauf_Prognose" Sheets="ExcelSheets" />
    </div>
    <div class="ll-kpis">
        <div class="ll-kpi"><div class="ll-kpi-value">@Short(_f.Last12)</div><div class="ll-kpi-label">@T("Umsatz CHF", "Sales CHF") @CurrentPeriod(_data)</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value @(_f.Last12 >= _f.Previous12 ? "sal-up" : "sal-down")">@Percent(_f.Previous12 == 0 ? null : (_f.Last12 - _f.Previous12) / _f.Previous12 * 100)</div><div class="ll-kpi-label">@T("Wachstum zum Vorjahr", "growth to previous year") (@PreviousPeriod(_data))</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@Short(_f.Forecast.Sum(v => v.Value))</div><div class="ll-kpi-label">@T("Prognose nächste 12 Monate", "forecast next 12 months")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@(_f.BacktestMape is { } m ? "± " + (m * 100).ToString("0") + " %" : "–")</div><div class="ll-kpi-label">@(_f.BacktestMape is null ? T("Rückrechnung erst ab drei Jahren Daten", "backtest only from three years of data") : T("typische Abweichung je Monat (Rückrechnung)", "typical deviation per month (backtest)"))</div></div>
    </div>
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-3 ll-panel" Outlined="true">
                <MudText Typo="Typo.h6">@T("Verlauf und Prognose", "History and forecast")</MudText>
                <MudText Typo="Typo.caption" Class="ll-muted d-block mb-2">@T("Ist ab Datenbeginn, danach 12 Monate Prognose: gleicher Monat im Vorjahr mal Wachstum im Vorjahresvergleich. Das Band zeigt die typische Abweichung aus der Rückrechnung auf das letzte Jahr. Eine einfache, nachvollziehbare Methode, keine Planung.", "Actuals from the start of the data, then 12 months forecast: same month last year times year-on-year growth. The band shows the typical deviation from the backtest on the last year. A simple, traceable method, not a plan.")</MudText>
                @{
                    var all = _f.History.Concat(_f.Forecast).ToList();
                    var max = (double)Math.Max(1, all.Max(v => v.Value)) * (1 + (_f.BacktestMape ?? 0)) * 1.05;
                    var w = 940.0 / all.Count;
                    double Xm(int i) => 40 + i * w + w / 2;
                    double Yv(double v) => 250 - 230 * v / max;
                    var band = _f.BacktestMape ?? 0;
                    var fStart = _f.History.Count;
                }
                <svg viewBox="0 0 1000 280" class="sal-fc">
                    @for (var g = 0; g <= 4; g++)
                    {
                        <g><line x1="40" y1="@F(20 + g * 57.5)" x2="990" y2="@F(20 + g * 57.5)" class="nw-grid" /><text x="36" y="@F(24 + g * 57.5)" text-anchor="end" class="nw-axis">@Short((decimal)(max * (4 - g) / 4))</text></g>
                    }
                    @for (var i = 0; i < _f.History.Count; i++)
                    {
                        var v = (double)_f.History[i].Value;
                        <g><rect x="@F(40 + i * w + 2)" y="@F(Yv(Math.Max(0, v)))" width="@F(w - 4)" height="@F(250 - Yv(Math.Max(0, v)))" rx="2" class="sal-month" style="animation-delay:@(F(i * 0.015))s"><title>@_f.History[i].Month.ToString("MM.yyyy") · @Chf(_f.History[i].Value)</title></rect></g>
                    }
                    <polygon class="sal-fc-band" points="@string.Join(" ", _f.Forecast.Select((v, i) => $"{F(Xm(fStart + i))},{F(Yv((double)v.Value * (1 + band)))}").Concat(_f.Forecast.Select((v, i) => $"{F(Xm(fStart + i))},{F(Yv((double)v.Value * (1 - band)))}").Reverse()))" />
                    <polyline class="sal-fc-line" pathLength="1" points="@string.Join(" ", _f.Forecast.Select((v, i) => $"{F(Xm(fStart + i))},{F(Yv((double)v.Value))}"))" />
                    @for (var i = 0; i < _f.Forecast.Count; i++)
                    {
                        <circle cx="@F(Xm(fStart + i))" cy="@F(Yv((double)_f.Forecast[i].Value))" r="4" class="sal-fc-dot"><title>@T("Prognose", "Forecast") @_f.Forecast[i].Month.ToString("MM.yyyy") · @Chf(_f.Forecast[i].Value)</title></circle>
                    }
                    <line x1="@F(40 + fStart * w)" y1="16" x2="@F(40 + fStart * w)" y2="254" class="dir-mig-today" />
                    @for (var i = 0; i < all.Count; i++)
                    {
                        if (all[i].Month.Month != 1) continue;
                        <g><text x="@F(40 + i * w)" y="272" class="nw-axis">@all[i].Month.Year</text></g>
                    }
                </svg>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-3 ll-panel" Outlined="true">
                <MudText Typo="Typo.h6">@T("Saisonmuster", "Seasonal pattern")</MudText>
                <MudText Typo="Typo.caption" Class="ll-muted d-block mb-2">@T("Anteil jedes Monats am Monatsmittel, aus bis zu drei vollen Jahren (mit weniger als drei Jahren noch unsicher). Über dem Kreis: stärker als der Durchschnitt.", "Share of each month in the monthly average, from up to three full years (still uncertain with fewer than three years). Outside the circle: stronger than average.")</MudText>
                <svg viewBox="0 0 300 300" class="sal-radial">
                    <circle cx="150" cy="150" r="70" class="sal-radial-ref" />
                    @for (var m = 0; m < 12; m++)
                    {
                        var idx = Math.Clamp(_f.SeasonIndex[m], 0, 2.2);
                        var r1 = 30 + 40 * idx;
                        <path d="@Wedge(150, 150, 30, r1, m / 12.0 + 0.004, (m + 1) / 12.0 - 0.004)" class="sal-radial-seg @(idx >= 1 ? "sal-radial-hi" : "sal-radial-lo")" style="animation-delay:@(F(m * 0.06))s"><title>@MonthName(m): @((_f.SeasonIndex[m] * 100).ToString("0")) %</title></path>
                        var (lx, ly) = Polar(150, 150, 138, (m + 0.5) / 12.0);
                        <g><text x="@F(lx)" y="@F(ly + 4)" text-anchor="middle" class="nw-axis">@MonthName(m)</text></g>
                    }
                </svg>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <SalesStatus Data="_data" />
}

@code {
    private const string Total = "*";
    private SalesDataset? _data;
    private List<string> _dimensions = [];
    private string _dimension = Total;
    private SalesForecast? _f;

    protected override async Task OnInitializedAsync()
    {
        _data = await Sales.GetAsync();
        if (_data.Error is not null)
            return;
        var from = _data.ReferenceEnd.AddMonths(-12);
        var recent = _data.Facts.Where(f => f.Date >= from && f.Date < _data.ReferenceEnd).ToList();
        _dimensions = [Total];
        _dimensions.AddRange(recent.GroupBy(f => f.Division).OrderByDescending(g => g.Sum(f => f.ValueChf)).Take(10).Select(g => "S:" + g.Key));
        _dimensions.AddRange(recent.GroupBy(f => f.Tsc).OrderByDescending(g => g.Sum(f => f.ValueChf)).Select(g => "G:" + g.Key));
        Choose(Total);
    }

    private void Choose(string dimension)
    {
        _dimension = dimension;
        IEnumerable<SalesFact> facts = _data!.Facts;
        if (dimension.StartsWith("S:", StringComparison.Ordinal)) facts = facts.Where(f => f.Division == dimension[2..]);
        else if (dimension.StartsWith("G:", StringComparison.Ordinal)) facts = facts.Where(f => f.Tsc == dimension[2..]);
        _f = SalesAnalytics.Forecast(dimension, facts.ToList(), _data.ReferenceEnd, _data.DataStart, _data.CompareMonths);
    }

    private string Label(string d) => d == Total ? T("Gesamt", "Total")
        : d.StartsWith("S:", StringComparison.Ordinal) ? T("Sparte", "Division") + ": " + d[2..]
        : T("Gesellschaft", "Company") + ": " + d[2..];

    private static string MonthName(int m) => System.Globalization.CultureInfo.GetCultureInfo("de-CH").DateTimeFormat.AbbreviatedMonthNames[m];

    private static (double X, double Y) Polar(double cx, double cy, double r, double f)
        => (cx + r * Math.Sin(2 * Math.PI * f), cy - r * Math.Cos(2 * Math.PI * f));

    private static string Wedge(double cx, double cy, double r0, double r1, double from, double to)
        => TrafagSalesExporter.Components.Network.NetSvg.Ring(cx, cy, r0, r1, from, to);

    private IReadOnlyList<ExcelSheetData> ExcelSheets() =>
    [
        new("Verlauf und Prognose", Rows(_f!.History.Select(v => (v, Art: "Ist")).Concat(_f.Forecast.Select(v => (v, Art: "Prognose"))), x => new Dictionary<string, object?>
        {
            ["Sicht"] = Label(_dimension), ["Monat"] = x.v.Month.ToDateTime(TimeOnly.MinValue), ["Art"] = x.Art, ["CHF"] = x.v.Value
        })),
        new("Saisonindex", Rows(Enumerable.Range(0, 12), m => new Dictionary<string, object?> { ["Monat"] = m + 1, ["Index"] = Math.Round(_f.SeasonIndex[m], 3) }))
    ];

    private string T(string german, string english) => UiText.Text(german, english);
}
