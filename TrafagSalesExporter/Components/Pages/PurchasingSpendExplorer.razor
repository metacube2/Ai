@using System.Globalization
@using System.Text
@using TrafagSalesExporter.Models
@using TrafagSalesExporter.Services
@inject TrafagSalesExporter.Services.IUiTextService UiText

@* Reiter „Spend-Aufriss" (2026-07-24): baut auf dem abgenommenen Spend-Reiter auf, laesst ihn aber
   unangetastet. Drei Sichten: (1) mehrstufige Kaskade Lieferant -> Warengruppe -> Artikel,
   (2) Region-Kuchen je Warengruppe, (3) Volumen nach ABC / XYZ. Region/ABC/XYZ fuellen sich erst
   mit dem naechsten Einkauf-Full-Load. *@

<MudPaper Class="pa-3 purchasing-section-shell mb-3" Outlined="true">
    <div class="purchasing-section-head">
        <div>
            <MudText Typo="Typo.h6">@T("Spend-Aufriss (mehrstufig)", "Spend breakdown (multi-level)")</MudText>
            <MudText Typo="Typo.body2" Class="purchasing-explorer-muted">
                @T("Kaskadierung wie in der Sitzung gewuenscht: Lieferant aufklappen zeigt seine Warengruppen, Warengruppe aufklappen zeigt die Artikel. Je Ebene sind die groessten Positionen einzeln, der Rest steckt in einer 'uebrige'-Zeile. Warengruppe aus Materialstamm (MARA-MATKL), Fallback Bestellbeleg.",
                   "Cascade as requested in the meeting: expanding a supplier shows its material groups, expanding a group shows the articles. Each level lists the largest positions individually, the rest is bundled into a 'remaining' row. Material group from material master (MARA-MATKL), fallback purchase document.")
            </MudText>
        </div>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">@T("Live aus Einkauf-Cache", "Live from purchasing cache")</MudChip>
    </div>

    @if (CascadeRows.Count == 0 || SpendYears.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            @T("Noch keine Spend-Daten im gewaehlten Zeitraum. Einkauf-Full-Load ausfuehren oder Zeitraum anpassen.",
               "No spend data in the selected period yet. Run a purchasing full load or adjust the period.")
        </MudAlert>
    }
    else
    {
        <div class="purchasing-matrix-scroll mt-2">
            <table class="purchasing-matrix">
                <thead>
                    <tr>
                        <th>@T("Aufriss", "Breakdown")</th>
                        @foreach (var year in SpendYears)
                        {
                            <th>@year</th>
                        }
                        <th>@T("Gesamt", "Total")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in CascadeRows)
                    {
                        var supplierKey = $"1|{supplier.Label}";
                        var supplierExpanded = _expanded.Contains(supplierKey);
                        <tr class="purchasing-cascade-l1">
                            <td>
                                @if (supplier.Children.Count > 0)
                                {
                                    <button type="button" class="purchasing-matrix-toggle" @onclick="() => Toggle(supplierKey)"
                                            title="@T("Warengruppen auf-/zuklappen", "Expand/collapse material groups")">
                                        @(supplierExpanded ? "▾" : "▸")
                                    </button>
                                }
                                <strong>@supplier.Label</strong>
                            </td>
                            @foreach (var year in SpendYears)
                            {
                                <td>@FormatAmount(GetYear(supplier, year))</td>
                            }
                            <td><strong>@FormatAmount(supplier.Total)</strong></td>
                        </tr>
                        @if (supplierExpanded)
                        {
                            @foreach (var group in supplier.Children)
                            {
                                var groupKey = $"{supplierKey}|2|{group.Label}";
                                var groupExpanded = _expanded.Contains(groupKey);
                                <tr class="purchasing-cascade-l2">
                                    <td>
                                        @if (group.Children.Count > 0)
                                        {
                                            <button type="button" class="purchasing-matrix-toggle" @onclick="() => Toggle(groupKey)"
                                                    title="@T("Artikel auf-/zuklappen", "Expand/collapse articles")">
                                                @(groupExpanded ? "▾" : "▸")
                                            </button>
                                        }
                                        @group.Label
                                    </td>
                                    @foreach (var year in SpendYears)
                                    {
                                        <td>@FormatAmount(GetYear(group, year))</td>
                                    }
                                    <td>@FormatAmount(group.Total)</td>
                                </tr>
                                @if (groupExpanded)
                                {
                                    @foreach (var article in group.Children)
                                    {
                                        <tr class="purchasing-cascade-l3">
                                            <td>@article.Label</td>
                                            @foreach (var year in SpendYears)
                                            {
                                                <td>@FormatAmount(GetYear(article, year))</td>
                                            }
                                            <td>@FormatAmount(article.Total)</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</MudPaper>

<MudPaper Class="pa-3 purchasing-section-shell mb-3" Outlined="true">
    <div class="purchasing-section-head">
        <div>
            <MudText Typo="Typo.h6">@T("Kuchen je Warengruppe: Anteil nach Beschaffungsregion", "Pie by material group: share by procurement region")</MudText>
            <MudText Typo="Typo.body2" Class="purchasing-explorer-muted">
                @T("Je Top-Warengruppe der CHF-Anteil je Lieferantenland. Region = Land des Lieferanten (LFA1-Land1).",
                   "Per top material group the CHF share by supplier country. Region = supplier country (LFA1 Land1).")
            </MudText>
        </div>
    </div>
    @if (RegionGroups.Count == 0 || RegionGroups.All(HasOnlyUnknownRegion))
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            @T("Lieferantenland (SupplierCountry) ist im Cache noch leer. Die Kuchen fuellen sich mit dem naechsten Einkauf-Full-Load.",
               "Supplier country is still empty in the cache. The pies fill with the next purchasing full load.")
        </MudAlert>
    }
    else
    {
        <div class="purchasing-pie-grid mt-2">
            @foreach (var group in RegionGroups)
            {
                <div class="purchasing-pie-card">
                    <div class="purchasing-pie" style="@BuildPieStyle(group)"></div>
                    <div class="purchasing-pie-legend">
                        <div class="purchasing-pie-title">@group.MaterialGroup</div>
                        <div class="purchasing-pie-total">@FormatChf(group.Total)</div>
                        @{ var sliceIndex = 0; }
                        @foreach (var slice in group.Slices)
                        {
                            var color = Palette[sliceIndex % Palette.Length];
                            sliceIndex++;
                            <div class="purchasing-pie-row">
                                <span class="purchasing-pie-swatch" style="@($"background:{color}")"></span>
                                <span class="purchasing-pie-label">@slice.Label</span>
                                <span class="purchasing-pie-share">@FormatShare(slice.Value, group.Total)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</MudPaper>

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-3 purchasing-section-shell" Outlined="true">
            <div class="purchasing-section-panel-head">
                <MudText Typo="Typo.subtitle1">@T("Volumen nach ABC", "Volume by ABC")</MudText>
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Info" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.caption" Class="purchasing-explorer-muted mb-2">
                @T("ABC-Kennzeichen aus dem Materialstamm (MARC-MAABC). Fuellt sich mit dem naechsten Einkauf-Full-Load.",
                   "ABC indicator from the material master (MARC-MAABC). Fills with the next purchasing full load.")
            </MudText>
            @if (BarsEmptyOrUnknown(AbcRows, "ohne ABC"))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @T("ABC-Kennzeichen im Cache noch leer. Fuellt sich mit dem naechsten Einkauf-Full-Load.",
                       "ABC indicator still empty in the cache. Fills with the next purchasing full load.")
                </MudAlert>
            }
            else
            {
                <div class="purchasing-explorer-bars">
                    @foreach (var bar in BuildBars(AbcRows))
                    {
                        <div class="purchasing-bar-row">
                            <div class="purchasing-bar-label">@bar.Label</div>
                            <div class="purchasing-bar-track">
                                <div class="purchasing-bar-fill" style="@($"width:{FormatPercent(bar.Percent)}%; background:{bar.Color}")"></div>
                            </div>
                            <div class="purchasing-bar-value">@bar.ValueText</div>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-3 purchasing-section-shell" Outlined="true">
            <div class="purchasing-section-panel-head">
                <MudText Typo="Typo.subtitle1">@T("Volumen nach XYZ", "Volume by XYZ")</MudText>
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Info" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.caption" Class="purchasing-explorer-muted mb-2">
                @T("XYZ-Klassifizierung aus der SAP-Zusatztabelle ZCA_MAT_ABC_XYZ. Fuellt sich mit dem naechsten Einkauf-Full-Load.",
                   "XYZ classification from the SAP add-on table ZCA_MAT_ABC_XYZ. Fills with the next purchasing full load.")
            </MudText>
            @if (BarsEmptyOrUnknown(XyzRows, "ohne XYZ"))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @T("XYZ-Klassifizierung im Cache noch leer. Fuellt sich mit dem naechsten Einkauf-Full-Load.",
                       "XYZ classification still empty in the cache. Fills with the next purchasing full load.")
                </MudAlert>
            }
            else
            {
                <div class="purchasing-explorer-bars">
                    @foreach (var bar in BuildBars(XyzRows))
                    {
                        <div class="purchasing-bar-row">
                            <div class="purchasing-bar-label">@bar.Label</div>
                            <div class="purchasing-bar-track">
                                <div class="purchasing-bar-fill" style="@($"width:{FormatPercent(bar.Percent)}%; background:{bar.Color}")"></div>
                            </div>
                            <div class="purchasing-bar-value">@bar.ValueText</div>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public IReadOnlyList<int> SpendYears { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchasingSpendCascadeNode> CascadeRows { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchasingRegionPieGroup> RegionGroups { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchasingLiveChartPoint> AbcRows { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchasingLiveChartPoint> XyzRows { get; set; } = [];

    private static readonly string[] Palette = ["#1565c0", "#2e7d32", "#ef6c00", "#6a1b9a", "#00838f", "#ad1457", "#5d4037", "#455a64", "#9e9d24"];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private void Toggle(string key)
    {
        if (!_expanded.Remove(key))
            _expanded.Add(key);
    }

    private string T(string german, string english) => UiText.Text(german, english);

    private static decimal GetYear(PurchasingSpendCascadeNode node, int year)
        => node.YearValues.TryGetValue(year, out var value) ? value : 0m;

    private static string FormatAmount(decimal value)
        => value == 0m ? "-" : value.ToString("N2", CultureInfo.CurrentCulture);

    private static string FormatChf(decimal value)
        => "CHF " + value.ToString("N0", CultureInfo.CurrentCulture);

    private static string FormatShare(decimal value, decimal total)
        => total <= 0m ? "-" : (value / total * 100m).ToString("0.#", CultureInfo.CurrentCulture) + " %";

    private static bool HasOnlyUnknownRegion(PurchasingRegionPieGroup group)
        => group.Slices.All(slice => slice.Label.Equals("ohne Land", StringComparison.OrdinalIgnoreCase));

    private static string BuildPieStyle(PurchasingRegionPieGroup group)
    {
        var total = group.Slices.Sum(slice => slice.Value);
        if (total <= 0m)
            return "background:conic-gradient(#cfd8dc 0 100%)";

        var sb = new StringBuilder("background:conic-gradient(");
        decimal cumulative = 0m;
        for (var i = 0; i < group.Slices.Count; i++)
        {
            var start = cumulative / total * 100m;
            cumulative += group.Slices[i].Value;
            var end = cumulative / total * 100m;
            if (i > 0)
                sb.Append(", ");
            sb.Append(Palette[i % Palette.Length])
              .Append(' ')
              .Append(start.ToString("0.##", CultureInfo.InvariantCulture))
              .Append("% ")
              .Append(end.ToString("0.##", CultureInfo.InvariantCulture))
              .Append('%');
        }

        sb.Append(')');
        return sb.ToString();
    }

    private sealed record BarRow(string Label, string ValueText, double Percent, string Color);

    private List<BarRow> BuildBars(IReadOnlyList<PurchasingLiveChartPoint> rows)
    {
        var max = rows.Count == 0 ? 0m : rows.Max(row => row.Value);
        return rows
            .Select((row, index) => new BarRow(
                row.Label,
                FormatChf(row.Value),
                max <= 0m ? 0d : Math.Clamp((double)(row.Value / max * 100m), 3d, 100d),
                Palette[index % Palette.Length]))
            .ToList();
    }

    // Leer-Zustand: keine Zeilen ODER alles in der Sammelklasse (z.B. nur „ohne ABC"), typisch
    // solange der Cache das Feld noch nicht gefuellt hat -> ehrlicher Hinweis statt einer Scheinsaeule.
    private static bool BarsEmptyOrUnknown(IReadOnlyList<PurchasingLiveChartPoint> rows, string unknownLabel)
        => rows.Count == 0 || rows.All(row => row.Label.Equals(unknownLabel, StringComparison.OrdinalIgnoreCase));

    private static string FormatPercent(double percent)
        => percent.ToString("0.##", CultureInfo.InvariantCulture);
}

<style>
    /* Basisklassen bewusst hier dupliziert: der „aufriss"-Case rendert PurchasingSection nicht,
       dessen (globaler) Style-Block waere also nicht geladen. Regeln identisch gehalten. */
    .purchasing-section-shell {
        border-radius: 8px;
        background:
            linear-gradient(180deg, rgba(21,101,192,.045), rgba(21,101,192,0) 210px),
            var(--mud-palette-surface);
    }

    .purchasing-section-head,
    .purchasing-section-panel-head {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 14px;
    }

    .purchasing-section-head {
        margin-bottom: 14px;
    }

    .purchasing-section-panel-head {
        align-items: center;
        margin-bottom: 12px;
    }

    .purchasing-matrix-scroll {
        overflow-x: auto;
    }

    .purchasing-matrix {
        width: 100%;
        border-collapse: collapse;
        font-size: .86rem;
        min-width: 860px;
    }

    .purchasing-matrix th,
    .purchasing-matrix td {
        padding: 7px 9px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        text-align: right;
        white-space: nowrap;
    }

    .purchasing-matrix th:first-child,
    .purchasing-matrix td:first-child {
        text-align: left;
        position: sticky;
        left: 0;
        z-index: 1;
        background: var(--mud-palette-surface);
        min-width: 280px;
    }

    .purchasing-matrix thead th {
        font-weight: 700;
        background: rgba(21,101,192,.08);
    }

    .purchasing-matrix-toggle {
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: .95rem;
        padding: 0 6px 0 0;
        color: var(--mud-palette-primary);
    }

    .purchasing-explorer-bars .purchasing-bar-row {
        display: grid;
        grid-template-columns: minmax(120px, 1fr) 2fr auto;
        gap: 10px;
        align-items: center;
    }

    .purchasing-explorer-bars .purchasing-bar-track {
        height: 24px;
        background: rgba(0,0,0,.08);
        border-radius: 4px;
        overflow: hidden;
    }

    .purchasing-explorer-bars .purchasing-bar-fill {
        height: 100%;
        border-radius: 4px;
        min-width: 26px;
        box-shadow: inset 0 -8px 16px rgba(0,0,0,.12);
    }

    .purchasing-explorer-bars .purchasing-bar-value {
        font-weight: 700;
        text-align: right;
    }

    .purchasing-explorer-bars .purchasing-bar-label {
        min-width: 0;
        overflow-wrap: anywhere;
        line-height: 1.2;
    }

    .purchasing-explorer-muted {
        color: var(--mud-palette-text-secondary);
    }

    .purchasing-cascade-l1 td {
        font-weight: 600;
    }

    .purchasing-cascade-l2 td:first-child {
        padding-left: 30px;
    }

    .purchasing-cascade-l2 td {
        background: rgba(21,101,192,.04);
    }

    .purchasing-cascade-l3 td:first-child {
        padding-left: 56px;
    }

    .purchasing-cascade-l3 td {
        font-size: .82rem;
        color: var(--mud-palette-text-secondary);
        background: rgba(21,101,192,.02);
    }

    .purchasing-pie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .purchasing-pie-card {
        display: flex;
        gap: 14px;
        align-items: center;
        padding: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .purchasing-pie {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        flex: 0 0 auto;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
    }

    .purchasing-pie-legend {
        min-width: 0;
        flex: 1 1 auto;
    }

    .purchasing-pie-title {
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .purchasing-pie-total {
        font-size: .82rem;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 6px;
    }

    .purchasing-pie-row {
        display: grid;
        grid-template-columns: 14px 1fr auto;
        gap: 6px;
        align-items: center;
        font-size: .8rem;
        padding: 1px 0;
    }

    .purchasing-pie-swatch {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

    .purchasing-pie-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .purchasing-pie-share {
        font-weight: 600;
    }

    .purchasing-explorer-bars {
        display: grid;
        gap: 10px;
    }
</style>
