@inject TrafagSalesExporter.Services.IUiTextService UiText
@using TrafagSalesExporter.Models

@* Matrix Lieferant / Jahr mit Aufklappen auf Warengruppe und Material. Herausgeloest aus PurchasingSection am
   2026-10-28 (Wunsch Ingo), damit der Spend-Aufriss sie zeigt und der alte Reiter Spend entfallen kann. *@

@if (Rows.Count > 0 && Years.Count > 0)
{
    <MudPaper Class="pa-3 purchasing-section-panel mb-3" Outlined="true">
        <div class="purchasing-section-panel-head">
            <MudText Typo="Typo.subtitle1">@T("Kaskadierung Lieferant / Jahr", "Supplier / year cascade")</MudText>
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Info" Size="Size.Small" />
        </div>
        <MudText Typo="Typo.caption" Class="purchasing-section-muted mb-2">
            @* Hinweis 2026-07-30 aktualisiert: SAP liefert MARA-MATKL seit dem Full Load vom
               24.07., der alte Text ("folgt, sobald SAP das Feld liefert") war ueberholt.
               2026-08-27: Die Deckelungen sind weg (Wunsch Marco/Ingo), der Text nennt jetzt
               stattdessen, wie die Materialtexte zu lesen sind. *@
            @T("Lieferant aufklappen zeigt den Spend nach Warengruppe, Warengruppe aufklappen die einzelnen Materialnummern. Seit dem 27.08.2026 wird nichts mehr abgeschnitten: alle Lieferanten, Warengruppen und Materialien stehen hier. Ein Materialeintrag MIT Bindestrich ist ein echter Artikel, OHNE Bindestrich eine Textbestellung ohne Artikelstamm.",
               "Expanding a supplier shows spend by material group; expanding a material group shows the individual material numbers. Since 27.08.2026 nothing is truncated: all suppliers, material groups and materials are shown. A material entry WITH a hyphen is a real article, WITHOUT a hyphen a text order with no material master.")
        </MudText>
        <div class="purchasing-matrix-scroll">
            <table class="purchasing-matrix">
                <thead>
                    <tr>
                        <th>@T("Lieferant", "Supplier")</th>
                        @foreach (var year in Years)
                        {
                            <th>@year</th>
                        }
                        <th>@T("Gesamt", "Total")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        var isExpanded = _expandedSuppliers.Contains(row.Supplier);
                        <tr class="purchasing-matrix-supplier">
                            <td>
                                @if (row.MaterialGroups.Count > 0)
                                {
                                    <button type="button" class="purchasing-matrix-toggle" @onclick="() => ToggleSupplier(row.Supplier)"
                                            title="@T("Warengruppen auf-/zuklappen", "Expand/collapse material groups")">
                                        @(isExpanded ? "▾" : "▸")
                                    </button>
                                }
                                @row.Supplier
                            </td>
                            @foreach (var year in Years)
                            {
                                <td>@FormatAmount(GetYearValue(row, year))</td>
                            }
                            <td><strong>@FormatAmount(row.Total)</strong></td>
                        </tr>
                        @if (isExpanded)
                        {
                            @foreach (var group in row.MaterialGroups)
                            {
                                var groupKey = BuildGroupKey(row.Supplier, group.MaterialGroup);
                                var isGroupExpanded = _expandedGroups.Contains(groupKey);
                                <tr class="purchasing-matrix-drill">
                                    <td>
                                        @if (group.Articles.Count > 0)
                                        {
                                            <button type="button" class="purchasing-matrix-toggle" @onclick="() => ToggleGroup(groupKey)"
                                                    title="@T("Materialnummern auf-/zuklappen", "Expand/collapse material numbers")">
                                                @(isGroupExpanded ? "▾" : "▸")
                                            </button>
                                        }
                                        @group.MaterialGroup
                                    </td>
                                    @foreach (var year in Years)
                                    {
                                        <td>@FormatAmount(GetGroupYearValue(group, year))</td>
                                    }
                                    <td>@FormatAmount(group.Total)</td>
                                </tr>
                                @if (isGroupExpanded)
                                {
                                    @foreach (var article in group.Articles)
                                    {
                                        <tr class="@(article.IsRemainder ? "purchasing-matrix-drill purchasing-matrix-drill-article purchasing-matrix-remainder" : "purchasing-matrix-drill purchasing-matrix-drill-article")">
                                            <td>@article.Article</td>
                                            @foreach (var year in Years)
                                            {
                                                <td>@FormatAmount(GetArticleYearValue(article, year))</td>
                                            }
                                            <td>@FormatAmount(article.Total)</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public IReadOnlyList<int> Years { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchasingSupplierYearSpendRow> Rows { get; set; } = [];

    private readonly HashSet<string> _expandedSuppliers = new(StringComparer.OrdinalIgnoreCase);

    // Dritte Ebene (Warengruppe -> Materialnummern, Entscheid Marco 2026-07-30). Der Schluessel
    // enthaelt den Lieferanten, weil dieselbe Warengruppe unter mehreren Lieferanten vorkommt und
    // sonst das Aufklappen bei "01 - Dummy" alle Lieferanten gleichzeitig oeffnen wuerde.
    private readonly HashSet<string> _expandedGroups = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleSupplier(string supplier)
    {
        if (!_expandedSuppliers.Remove(supplier))
            _expandedSuppliers.Add(supplier);
    }

    private void ToggleGroup(string groupKey)
    {
        if (!_expandedGroups.Remove(groupKey))
            _expandedGroups.Add(groupKey);
    }

    // Unit Separator (U+001F) als Trenner, damit ein Lieferanten- oder Warengruppentext mit
    // Sonderzeichen keine Schluesselkollision erzeugt.
    private static string BuildGroupKey(string supplier, string materialGroup)
        => string.Concat(supplier, GroupKeySeparator, materialGroup);

    private const char GroupKeySeparator = (char)0x1F;

    private static decimal GetYearValue(PurchasingSupplierYearSpendRow row, int year)
        => row.YearValues.TryGetValue(year, out var value) ? value : 0m;

    private static decimal GetGroupYearValue(PurchasingSpendGroupYearRow row, int year)
        => row.YearValues.TryGetValue(year, out var value) ? value : 0m;

    private static decimal GetArticleYearValue(PurchasingSpendArticleYearRow row, int year)
        => row.YearValues.TryGetValue(year, out var value) ? value : 0m;

    private static string FormatAmount(decimal value)
        => value == 0m ? "-" : value.ToString("N2", System.Globalization.CultureInfo.CurrentCulture);

    private string T(string german, string english) => UiText.Text(german, english);
}

<style>
    .purchasing-matrix-scroll {
        overflow-x: auto;
    }

    .purchasing-matrix {
        width: 100%;
        border-collapse: collapse;
        font-size: .86rem;
        min-width: 860px;
    }

    .purchasing-matrix th,
    .purchasing-matrix td {
        padding: 7px 9px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        text-align: right;
        white-space: nowrap;
    }

    .purchasing-matrix th:first-child,
    .purchasing-matrix td:first-child {
        text-align: left;
        position: sticky;
        left: 0;
        z-index: 1;
        background: var(--mud-palette-surface);
        min-width: 250px;
    }

    .purchasing-matrix thead th {
        font-weight: 700;
        background: rgba(21,101,192,.08);
    }

    .purchasing-matrix-supplier td {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .purchasing-matrix-toggle {
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: .95rem;
        padding: 0 6px 0 0;
        color: var(--mud-palette-primary);
    }

    .purchasing-matrix-drill td {
        background: rgba(21,101,192,.10);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--mud-palette-text-primary);
    }

    .purchasing-matrix-drill td:first-child {
        padding-left: 34px;
        background: rgba(21,101,192,.06);
    }

    /* Dritte Ebene (Materialnummern unter der Warengruppe, 2026-07-30): staerker eingerueckt und
       etwas dunkler hinterlegt, damit die drei Ebenen im Aufriss auf einen Blick unterscheidbar
       bleiben. */
    .purchasing-matrix-drill-article td {
        background: rgba(21,101,192,.14);
        font-size: 1rem;
    }

    .purchasing-matrix-drill-article td:first-child {
        padding-left: 62px;
    }

    /* Die Sammelzeile "uebrige (n)" ist keine echte Materialnummer - kursiv und blasser, damit sie
       beim Suchen nach einem konkreten Material nicht mitgelesen wird. */
    .purchasing-matrix-remainder td {
        font-style: italic;
        opacity: .88;
    }
</style>
