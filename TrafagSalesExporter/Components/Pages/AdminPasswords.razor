@page "/admin/passwoerter"
@rendermode @(Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer)
@attribute [Authorize(Policy = TrafagSalesExporter.Security.SecurityPolicies.AdminOnly)]
@using TrafagSalesExporter.Services
@inject IAdminAccessService AdminAccess
@inject IAccessPasswordAdministration Passwords
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IUiTextService UiText

@* Passwoerter aller Bereichs-Logins an einer Stelle (Wunsch Ingo 2026-10-15). Der entsperrte Admin setzt neue Passwoerter,
   ohne das alte zu kennen. Gespeichert wird nur der Hash, in der Cockpit-DB, damit ein Deploy ihn nicht ueberschreibt. *@
<PageTitle>@T("Passwörter", "Passwords")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">@T("Passwörter", "Passwords")</MudText>

@if (!AdminAccess.IsUnlocked)
{
    <AdminAccessPanel OnUnlocked="Refresh" />
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4" Style="max-width:900px">
        @T("Hier setzt der Admin die Passwörter aller Bereiche neu. Das alte Passwort ist nicht nötig. Gespeichert wird nur ein Hash in der Datenbank, ein Deploy überschreibt ihn nicht. Wer im Bereich angemeldet ist, muss sich nach der Änderung neu anmelden.", "Here the admin sets new passwords for all areas. The old password is not needed. Only a hash is stored in the database, a deploy does not overwrite it. Anyone signed in to the area has to sign in again after the change.")
    </MudText>

    <MudPaper Outlined Class="pa-0 mb-4" Style="max-width:900px">
        <MudSimpleTable Dense Hover Striped>
            <thead>
                <tr>
                    <th>@T("Bereich", "Area")</th>
                    <th>@T("Benutzer", "User")</th>
                    <th>@T("Status", "Status")</th>
                    <th>@T("Zuletzt geändert", "Last changed")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _accounts)
                {
                    <tr>
                        <td>@a.Title</td>
                        <td>@a.Username</td>
                        <td>@(a.Configured ? T("gesetzt", "set") : T("fehlt", "missing"))</td>
                        <td>@(a.ChangedUtc is { } c ? c.ToLocalTime().ToString("dd.MM.yyyy HH:mm") + " · " + a.ChangedBy : T("aus der Konfiguration", "from configuration"))</td>
                        <td>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Password" OnClick="() => Select(a)">
                                @T("Neu setzen", "Set new")
                            </MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (_selected is not null)
    {
        <MudPaper Class="pa-4" Elevation="1" Style="max-width:520px">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">@(_selected.Title + " · " + _selected.Username)</MudText>
                <MudTextField @bind-Value="_newPassword" Label="@T("Neues Passwort", "New password")" InputType="InputType.Password"
                              HelperText="@T("Mindestens 8 Zeichen.", "At least 8 characters.")" />
                <MudTextField @bind-Value="_newPasswordRepeat" Label="@T("Neues Passwort wiederholen", "Repeat new password")" InputType="InputType.Password" />
                <MudStack Row>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">
                        @T("Passwort speichern", "Save password")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="Cancel">@T("Abbrechen", "Cancel")</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<AccessPasswordAccount> _accounts = [];
    private AccessPasswordAccount? _selected;
    private string? _newPassword;
    private string? _newPasswordRepeat;

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        if (AdminAccess.IsUnlocked)
            _accounts = Passwords.ListAccounts();
        StateHasChanged();
    }

    private void Select(AccessPasswordAccount account)
    {
        _selected = account;
        _newPassword = string.Empty;
        _newPasswordRepeat = string.Empty;
    }

    private void Cancel()
    {
        _selected = null;
        _newPassword = string.Empty;
        _newPasswordRepeat = string.Empty;
    }

    private async Task Save()
    {
        if (_selected is null)
            return;
        if (string.IsNullOrEmpty(_newPassword) || _newPassword.Length < AccessPasswordAdministration.MinimumLength)
        {
            Snackbar.Add(T("Das neue Passwort muss mindestens 8 Zeichen lang sein.", "The new password must be at least 8 characters long."), Severity.Warning);
            return;
        }
        if (_newPassword != _newPasswordRepeat)
        {
            Snackbar.Add(T("Die neuen Passwörter stimmen nicht überein.", "The new passwords do not match."), Severity.Warning);
            return;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        var changedBy = state.User.Identity?.Name ?? string.Empty;
        var slash = changedBy.LastIndexOf('\\');
        if (slash >= 0)
            changedBy = changedBy[(slash + 1)..];

        if (!Passwords.TrySetPassword(_selected.Area, _newPassword, changedBy))
        {
            Snackbar.Add(T("Passwort konnte nicht geändert werden.", "Password could not be changed."), Severity.Error);
            return;
        }

        var wasAdmin = _selected.Area == AccessPasswordAreas.Admin;
        Cancel();
        _accounts = Passwords.ListAccounts();
        Snackbar.Add(T("Passwort wurde geändert.", "Password has been changed."), Severity.Success);
        if (wasAdmin)
            Snackbar.Add(T("Admin-Passwort geändert: beim nächsten Neuladen der Seite bitte neu anmelden.", "Admin password changed: please sign in again the next time the page is reloaded."), Severity.Info);
    }

    private string T(string german, string english) => UiText.Text(german, english);
}
