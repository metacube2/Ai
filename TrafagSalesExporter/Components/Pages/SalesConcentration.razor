@page "/verkauf/konzentration"
@rendermode @(Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer)
@using TrafagSalesExporter.Services
@using TrafagSalesExporter.Components.Sales
@using static TrafagSalesExporter.Components.Sales.SalesUi
@inject SalesDataService Sales
@inject IUiTextService UiText

@* Reiter Verkauf, Kundenkonzentration (Pareto, HHI) (2026-10-02). Doku docs/VERKAUF_2026-10-02.md *@
<PageTitle>@T("Verkauf", "Sales") · @T("Konzentration", "Concentration")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@T("Verkauf", "Sales")</MudText>
<SalesTabs />

@if (_data is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_data.Error is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true">@_data.Error</MudAlert>
}
else if (_c is not null)
{
    <div class="ll-kpis">
        <div class="ll-kpi"><div class="ll-kpi-value">@Percent(_c.Top1)</div><div class="ll-kpi-label">@T("grösster Kunde", "largest customer")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@Percent(_c.Top5)</div><div class="ll-kpi-label">@T("Top 5", "Top 5")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@Percent(_c.Top10)</div><div class="ll-kpi-label">@T("Top 10", "Top 10")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@Percent(_c.Top20)</div><div class="ll-kpi-label">@T("Top 20", "Top 20")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value">@_c.CustomersFor80</div><div class="ll-kpi-label">@T("Kunden machen 80 % des Umsatzes", "customers make 80 % of sales")</div></div>
        <div class="ll-kpi"><div class="ll-kpi-value @(_c.Hhi > 1500 ? "sal-down" : "sal-up")">@_c.Hhi.ToString("N0")</div><div class="ll-kpi-label">@T("HHI (unter 1500 breit gestreut)", "HHI (below 1500 diversified)")</div></div>
    </div>
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-3 ll-panel" Outlined="true">
                <MudText Typo="Typo.h6">@T("Pareto-Kurve der Kunden, 12 Monate", "Customer Pareto curve, 12 months")</MudText>
                <MudText Typo="Typo.caption" Class="ll-muted d-block mb-2">@T("Kunden nach Umsatz sortiert, kumulierter Anteil am Gesamtumsatz. Je steiler der Anfang, desto abhängiger von wenigen Kunden. Kundenachse logarithmisch.", "Customers sorted by sales, cumulative share of total sales. The steeper the start, the more dependent on few customers. Customer axis logarithmic.")</MudText>
                <svg viewBox="0 0 640 340" class="sal-pareto">
                    @for (var g = 0; g <= 4; g++)
                    {
                        <g><line x1="50" y1="@F(20 + g * 75)" x2="630" y2="@F(20 + g * 75)" class="nw-grid" /><text x="44" y="@F(24 + g * 75)" class="nw-axis" style="text-anchor:end">@((100 - g * 25))%</text></g>
                    }
                    <polygon points="50,320 @string.Join(" ", _c.Curve.Select(p => $"{F(X(p.Rank))},{F(Y(p.CumulativeShare))}")) 630,320" class="sal-pareto-area" />
                    <polyline points="@string.Join(" ", _c.Curve.Select(p => $"{F(X(p.Rank))},{F(Y(p.CumulativeShare))}"))" class="sal-pareto-line" pathLength="1" />
                    <line x1="50" y1="@F(Y(0.8))" x2="@F(X(_c.CustomersFor80))" y2="@F(Y(0.8))" class="sal-pareto-mark" />
                    <line x1="@F(X(_c.CustomersFor80))" y1="@F(Y(0.8))" x2="@F(X(_c.CustomersFor80))" y2="320" class="sal-pareto-mark" />
                    <circle cx="@F(X(_c.CustomersFor80))" cy="@F(Y(0.8))" r="6" class="sal-pareto-dot" />
                    <text x="@F(X(_c.CustomersFor80) + 10)" y="@F(Y(0.8) + 18)" class="sal-bar-value">@_c.CustomersFor80 @T("von", "of") @_c.Customers @T("Kunden = 80 %", "customers = 80 %")</text>
                    <text x="630" y="336" class="nw-axis" style="text-anchor:end">@_c.Customers @T("Kunden", "customers")</text>
                </svg>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-3 ll-panel" Outlined="true">
                <MudText Typo="Typo.h6">@T("Anteil der Top 10 je Gesellschaft", "Top 10 share per company")</MudText>
                <MudText Typo="Typo.caption" Class="ll-muted d-block mb-2">@T("Wie stark eine Gesellschaft an ihren zehn grössten Kunden hängt.", "How much a company depends on its ten largest customers.")</MudText>
                @foreach (var (tsc, share, n) in _c.PerCompany)
                {
                    <div class="dir-ou-bar"><span style="width:60px"><b>@tsc</b></span><span class="dir-ou-track ll-grow" style="width:auto"><span class="@(share > 0.6 ? "sal-share-hi" : string.Empty)" style="width:@(F(share * 100))%"></span></span><span class="ll-mono" style="width:60px;text-align:right">@Percent(share)</span><span class="ll-mono ll-muted" style="width:60px;text-align:right">@n</span></div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
    <SalesStatus Data="_data" />
}

@code {
    private SalesDataset? _data;
    private SalesConcentrationResult? _c;

    protected override async Task OnInitializedAsync()
    {
        _data = await Sales.GetAsync();
        _c = _data.Error is null ? SalesAnalytics.Concentration(_data.Facts, _data.ReferenceEnd) : null;
    }

    private double X(int rank) => 50 + 580.0 * Math.Log(rank) / Math.Log(Math.Max(2, _c!.Customers));

    private static double Y(double share) => 320 - 300 * share;

    private string T(string german, string english) => UiText.Text(german, english);
}
