@page "/einkauf"
@page "/einkauf/spend"
@page "/einkauf/offene-bestellungen"
@page "/einkauf/kontrakte"
@page "/einkauf/lieferanten"
@page "/einkauf/aufriss"
@page "/einkauf/ideen"
@page "/einkauf/ideen/datenservice"
@page "/einkauf/ideen/liefertermin-risiko"
@page "/einkauf/ideen/preisabweichung"
@page "/einkauf/ideen/spend-konzentration"
@page "/einkauf/ideen/datenqualitaet"
@page "/einkauf/kennzahlen"
@page "/einkauf/pbix"
@page "/einkauf/3d"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using TrafagSalesExporter.Models
@using TrafagSalesExporter.Services
@implements IDisposable
@inject TrafagSalesExporter.Services.IUiTextService UiText
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IPurchasingDashboardService PurchasingDashboardService
@inject IPurchasingDataRefreshService PurchasingDataRefreshService
@inject IPurchasingRefreshRunner RefreshRunner

<PageTitle>@T("Einkauf", "Purchasing")</PageTitle>

<MudPaper Class="purchasing-hero mb-4" Elevation="0">
    <div class="purchasing-hero-main">
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
            @T("Einkauf Cockpit", "Purchasing cockpit")
        </MudChip>
        <MudText Typo="Typo.h3" Class="purchasing-hero-title">@T("Bestellwerte, Lieferanten und offene Liefermengen", "Ordered values, suppliers and open delivery quantities")</MudText>
        <MudText Typo="Typo.body1" Class="purchasing-hero-text">
            @T("Bestellungen, offene Liefermengen und Lagerwerte aus SAP. Die Quellenhilfe erklaert die Kennzahlen und nennt die SAP-Felder.",
               "Purchase orders, open delivery quantities and stock values from SAP. The source guide explains the measures and identifies their SAP fields.")
        </MudText>
        <div class="purchasing-hero-actions">
            <MudChip T="string" Size="Size.Small" Color="@(_liveState.EkkoLoaded ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                EKKO @(_liveState.EkkoLoaded ? DataSourceLabel : T("wartet", "pending"))
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_liveState.EkpoLoaded ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                EKPO @(_liveState.EkpoLoaded ? DataSourceLabel : T("wartet", "pending"))
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_liveState.EketLoaded ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                EKET @(_liveState.EketLoaded ? DataSourceLabel : T("wartet", "pending"))
            </MudChip>
        </div>
    </div>
    <div class="purchasing-hero-metrics">
        <div class="purchasing-radar" style="@BuildReadinessDonutStyle()">
            <div>
                <strong>@DataReadinessPercent.ToString("N0")%</strong>
                <span>@T("Geladen", "Loaded")</span>
            </div>
        </div>
        <div class="purchasing-hero-note">
            <strong>@DataReadinessText</strong>
            <span>@PurchasingStatusText</span>
        </div>
    </div>
</MudPaper>

<MudPaper Class="pa-3 mb-4 purchasing-filter-panel" Outlined="true">
    @if (_liveLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <div>
            <MudText Typo="Typo.subtitle1">@T("Zeitraum", "Period")</MudText>
            <MudText Typo="Typo.body2" Class="purchasing-muted">
                @T("Bestellwerte und Lieferantenzahl nach Bestelldatum (EKKO.BEDAT). Offene Werte enthalten alle Jahre; der Lagerwert zeigt seinen eigenen Ladestand.",
                   "Ordered values and supplier count use the order date (EKKO.BEDAT). Open values include all years; stock value has its own load timestamp.")
            </MudText>
        </div>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@FilterLabel</MudChip>
    </MudStack>
    <div class="purchasing-filter-grid">
        <MudDatePicker Date="@GetFilterFromDate()"
                       DateChanged="@OnFilterFromDateChangedAsync"
                       Label="@T("Von Monat", "From month")"
                       DateFormat="MM.yyyy"
                       OpenTo="OpenTo.Month"
                       FixDay="1"
                       MinDate="@(new DateTime(2020, 1, 1))"
                       MaxDate="@DateTime.Today"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_liveLoading" />
        <MudDatePicker Date="@GetFilterToDate()"
                       DateChanged="@OnFilterToDateChangedAsync"
                       Label="@T("Bis Monat", "To month")"
                       DateFormat="MM.yyyy"
                       OpenTo="OpenTo.Month"
                       FixDay="1"
                       MinDate="@(new DateTime(2020, 1, 1))"
                       MaxDate="@DateTime.Today"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_liveLoading" />
        <MudCheckBox T="bool" @bind-Value="_excludeDeletedItems" Dense="true" Color="Color.Primary" Label="@T("Stornierte Positionen raus (Spend); MARA-MSTAE 98/99 nur bei offenen Werten", "Exclude cancelled items (spend); MARA-MSTAE 98/99 only for open values")" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="ApplyPurchasingFilterAsync" Disabled="_liveLoading">
            @T("Anwenden", "Apply")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Update" OnClick="SetPurchasingRangeAsync" Disabled="_liveLoading">
            @T("2020 bis heute", "2020 to today")
        </MudButton>
        @if (_liveLoading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="purchasing-filter-loading">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Primary">@T("Laedt...", "Loading...")</MudText>
            </MudStack>
        }
    </div>
</MudPaper>

<MudPaper Class="pa-3 mb-4" Outlined="true">
    <MudText Typo="Typo.body2">
        @if (_liveLoading)
        {
            @T("Datenstatus wird geladen.", "Loading data status.")
        }
        else if (_liveState.UsesCache)
        {
            @T("Quelle: gespeicherte SAP-Daten, keine Echtzeitabfrage. Letzter protokollierter Ladelauf:", "Source: stored SAP data, not a real-time query. Last recorded load:")
            @TranslateRefreshStatus(_liveState.CacheStatus)
            @if (_liveState.CacheCompletedAtUtc is { } completedAt)
            {
                <span> · @FormatRefreshDate(completedAt)</span>
            }
            <span> · @T("Ein fehlgeschlagener oder laufender Ladelauf bestaetigt keinen neuen Datenstand. Der Lagerwert hat einen eigenen Zeitstempel an der Kachel.", "A failed or running load does not confirm a new data snapshot. Stock value has its own timestamp on the card.")</span>
        }
        else
        {
            @T("Ohne gespeicherten Bestand: begrenzte SAP-Stichprobe, sofern erreichbar. Stichproben und gekennzeichnete Simulationen sind keine vollstaendigen Einkaufswerte.", "Without stored data: a limited SAP sample, if reachable. Samples and labelled simulations are not complete purchasing totals.")
        }
    </MudText>
    <details class="mt-2">
        <summary>@T("Kennzahlen verstehen: SAP-Quellen und Felder", "Understanding measures: SAP sources and fields")</summary>
        <MudText Typo="Typo.body2" Class="my-2">
            @T("Die Formeln beschreiben den gespeicherten Einkaufsbestand. Bestellkopf EKKO und Position EKPO sind ueber EBELN verbunden; Einteilungen EKET ueber EBELN und EBELP. Die SAP-Feldnamen bleiben zum Nachschlagen unveraendert.", "The formulas describe the stored purchasing data. Order header EKKO and item EKPO join on EBELN; schedule lines EKET join on EBELN and EBELP. SAP field names are preserved for reference.")
        </MudText>
        <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto">
            <thead><tr>
                <th>@T("Kennzahl / Feld", "Measure / field")</th>
                <th>@T("Herkunft und Berechnung", "Source and calculation")</th>
            </tr></thead>
            <tbody>
                <tr><td>@T("Bestellwert / Jahr", "Ordered value / year")</td><td>@T("Summe EKPO.NETWR (Netto-Positionswert), in CHF umgerechnet. Zeitraum und Jahr aus EKKO.BEDAT (Bestelldatum). Kein Rechnungs- oder Zahlungswert.", "Sum of EKPO.NETWR (net item value), converted to CHF. Period and year from EKKO.BEDAT (order date). Not an invoice or payment value.")</td></tr>
                <tr><td>@T("Bestellungen / Lieferanten", "Orders / suppliers")</td><td>@T("Unterschiedliche EKKO.EBELN (Bestellnummern) mit passenden Positionen; Lieferanten als unterschiedliche EKKO.LIFNR mit EKPO.NETWR ungleich 0 im Zeitraum. Keine Lieferantenbewertung.", "Distinct EKKO.EBELN (order numbers) with matching items; suppliers are distinct EKKO.LIFNR with non-zero EKPO.NETWR in the period. Not a supplier rating.")</td></tr>
                <tr><td>@T("Offene Menge / offener Bestellwert", "Open quantity / order value")</td><td>@T("Je Einteilung: MAX(EKET.MENGE - EKET.WEMNG, 0), also eingeplante Menge minus erfasste Wareneingangsmenge. Wert = offene Menge × (EKPO.NETWR in CHF / EKPO.MENGE). Bei Bestellmenge 0 ist der Stueckwert 0. Alle Jahre inklusive alter Rueckstaende.", "Per schedule line: MAX(EKET.MENGE - EKET.WEMNG, 0), scheduled quantity minus recorded received quantity. Value = open quantity × (EKPO.NETWR in CHF / EKPO.MENGE). A zero order quantity gives a zero unit value. All years, including old backlogs.")</td></tr>
                <tr><td>@T("Ueberfaelliger Wert / Positionen", "Overdue value / items")</td><td>@T("Offener Bestellwert mit EKET.EINDT (geplanter Liefertermin) vor heute. Positionszahl zaehlt unterschiedliche EBELN/EBELP mit offener ueberfaelliger Einteilung. EKET.EINDT ist kein tatsaechliches Wareneingangsdatum; daraus wird keine Liefertreue berechnet.", "Open order value with EKET.EINDT (planned delivery date) before today. Item count uses distinct EBELN/EBELP with an overdue open schedule line. EKET.EINDT is not an actual receipt date; it does not measure delivery reliability.")</td></tr>
                <tr><td>@T("Offener Wert der Kontraktabrufe", "Open contract call-off value")</td><td>@T("Gleiche Offenwert-Formel, eingeschraenkt auf Bestellungen mit gefuelltem EKKO.KONNR (Kontraktbezug). Naeherung fuer offene Abrufe, kein noch verfuegbarer Vertragsrahmen. Ohne KONNR-Zuordnung ergibt sich 0.", "Same open-value formula, restricted to orders with EKKO.KONNR (contract reference). An approximation of open call-offs, not unused contract capacity. No KONNR assignments results in 0.")</td></tr>
                <tr><td>@T("Waehrung / CHF-Umrechnung", "Currency / CHF conversion")</td><td>@T("EKKO.WAERS ist die Belegwaehrung; EKKO.WKURS der Kurs des Bestellbelegs. Positiver Kurs: multiplizieren; negativer Kurs: durch den Absolutwert teilen. CHF bleibt unveraendert. Bei fehlender Waehrung oder Kurs 0 bleibt der Betrag derzeit ebenfalls unveraendert. Der Waehrungsaufriss gruppiert nach Belegwaehrung und zeigt CHF-Werte.", "EKKO.WAERS is the document currency; EKKO.WKURS the order document exchange rate. Positive rate: multiply; negative rate: divide by its absolute value. CHF is unchanged. Missing currency or a zero rate currently also leaves the amount unchanged. The currency breakdown groups by document currency and shows CHF values.")</td></tr>
                <tr><td>@T("Lieferant / Material / Warengruppe", "Supplier / material / material group")</td><td>@T("Lieferant: EKKO.LIFNR → LFA1.NAME1; Land: LFA1.LAND1. Material: EKPO.MATNR mit MAKT.MAKTX im Drilldown. Ohne Stammtext bleibt die Nummer; ohne Materialnummer wird EKPO.TXZ01 angezeigt. Warengruppe: MARA.MATKL, ersatzweise EKPO.MATKL; Texte aus dem lokalen T023T-Katalog.", "Supplier: EKKO.LIFNR → LFA1.NAME1; country: LFA1.LAND1. Material: EKPO.MATNR with MAKT.MAKTX in the drilldown. Missing master text leaves the number; without a material number, EKPO.TXZ01 is shown. Material group: MARA.MATKL, falling back to EKPO.MATKL; descriptions from the local T023T catalogue.")</td></tr>
                <tr><td>@T("Lagerwert Einkaufsteile", "Purchased parts stock value")</td><td>@T("Summe MBEW.SALK3 (bewerteter Gesamtbestand), Bewertungskreis MBEW.BWKEY = 1100; Zuordnung ueber Materialnummer zu MARC.DISPO, Disponenten 001–005. Eigener gespeicherter Abrufzeitpunkt an der Kachel; unabhaengig vom Bestellzeitraum.", "Sum of MBEW.SALK3 (valued total stock), valuation area MBEW.BWKEY = 1100; material number maps to MARC.DISPO, planners 001–005. Its own stored retrieval timestamp is shown on the card; independent of the order period.")</td></tr>
                <tr><td>@T("Beleg- und Positionsfilter", "Document and item filters")</td><td>@T("Standard: EKKO.BSTYP = F (Bestellung), EKKO.BSART ungleich UB (keine Umlagerung). Der Storno-Schalter schliesst EKPO.LOEKZ aus; bei offenen Werten zusaetzlich MARA.MSTAE 98/99. Endgelieferte Positionen (EKPO.ELIKZ = X) sind aus offenen Werten ausgeschlossen.", "Default: EKKO.BSTYP = F (purchase order), EKKO.BSART other than UB (no stock transfers). The cancellation filter excludes EKPO.LOEKZ; open values also exclude MARA.MSTAE 98/99. Delivery-completed items (EKPO.ELIKZ = X) are excluded from open values.")</td></tr>
            </tbody>
        </MudSimpleTable>
    </details>
</MudPaper>

<MudGrid Class="mb-4" Spacing="2">
    @foreach (var card in KpiCards)
    {
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="purchasing-kpi pa-3" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <div class="purchasing-kpi-icon">
                        <MudIcon Icon="@card.Icon" Color="@card.Color" Size="Size.Medium" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="purchasing-muted">@T(card.TitleDe, card.TitleEn)</MudText>
                        <MudText Typo="Typo.h6">@card.Value</MudText>
                        <MudText Typo="Typo.caption">@T(card.DetailDe, card.DetailEn)</MudText>
                        @* Zweite, ausfuehrliche Zeile: WAS genau gezaehlt wird und was NICHT.
                           Wunsch Ingo/Marco 2026-08-27 - die Kurzzeile darueber nennt nur die
                           Datenquelle, nicht die fachliche Bedeutung. Marco hat "Bereits
                           beschafft" deshalb als Wareneingang gelesen, was es nicht ist. *@
                        @if (!string.IsNullOrWhiteSpace(card.ExplainDe))
                        {
                            <MudText Typo="Typo.caption" Class="purchasing-muted d-block mt-1">@T(card.ExplainDe, card.ExplainEn)</MudText>
                        }
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@switch (CurrentPurchasingPage)
{
    case "spend":
        <PurchasingSection TitleDe="Bestellwert nach Lieferant und Jahr"
                           TitleEn="Ordered value by supplier and year"
                           DescriptionDe="Beschaffungsvolumen in CHF nach Lieferant und Jahr. Gezählt wird der Bestellpositionswert am Bestelldatum, also bestelltes Volumen und nicht Wareneingang oder Rechnung. Fremdwährungen mit dem Kurs vom Bestellbeleg. Seit dem 27.08.2026 vollständig, ohne Kürzung auf die grössten Lieferanten."
                           DescriptionEn="Purchasing volume in CHF by supplier and year. It counts the order item value on the order date, so ordered volume and not goods receipt or invoice. Foreign currencies use the rate from the order document. Complete since 27.08.2026, no longer truncated to the largest suppliers."
                           ChartTitleDe="Spend pro Lieferant im aktuellen Jahr"
                           ChartTitleEn="Spend by supplier in the current year"
                           Kpis="@SpendKpis"
                           ChartRows="@SpendChartRows"
                           StatusRows="@SpendStatusRows"
                           DetailRows="@SpendDetailRows"
                           SpendMatrixYears="@_liveState.SpendYears"
                           SpendMatrixRows="@_liveState.SupplierYearSpendRows"
                           ExtraCharts="@SpendExtraCharts" />
        break;
    case "offene-bestellungen":
        <PurchasingSection TitleDe="Offene Bestellwerte und Mengen"
                           TitleEn="Open order values and quantities"
                           DescriptionDe="Was ist bestellt und noch nicht da: offene Menge je Termineinteilung mal Stückwert. Bewusst zeitraumunabhängig, laut geladenem SAP-Stand über alle Jahre, damit alte Rückstände nicht verschwinden. Enthält auch alte, in SAP noch offene Rückstände. Nur Bestellungen, keine Mengenkontrakte."
                           DescriptionEn="What is ordered and not yet here: open quantity per schedule line times unit value. Deliberately period-independent, across all years in the loaded SAP data so old backlogs do not disappear. Includes old backlogs still open in SAP. Purchase orders only, no quantity contracts."
                           ChartTitleDe="Bestellaktivitaet und offene Positionen"
                           ChartTitleEn="Order activity and open items"
                           Kpis="@OpenOrderKpis"
                           ChartRows="@OpenOrderChartRows"
                           StatusRows="@OpenOrderStatusRows"
                           DetailRows="@OpenOrderDetailRows" />
        break;
    case "kontrakte":
        <PurchasingSection TitleDe="Offene Kontraktabrufe"
                           TitleEn="Open contract call-offs"
                           DescriptionDe="Naeherung: Restwert nur fuer Abrufe zu Rahmenkontrakten (EKKO.Konnr gesetzt), aus EKET-Offenmenge und EKPO-Stueckwert. Echte Mengenkontrakte mit Ablaufdatum brauchen noch Kontraktbelege aus SAP; bis dahin ist dieser Wert eine Annaeherung und 0, wenn keine Konnr-Daten vorliegen."
                           DescriptionEn="Approximation: remaining value only for call-offs against outline agreements (EKKO.Konnr set), from EKET open quantity and EKPO unit value. True quantity contracts with expiry dates still need contract documents from SAP; until then this value is an approximation and 0 when no Konnr data is present."
                           ChartTitleDe="Top Verpflichtungen nach Lieferant und Artikel"
                           ChartTitleEn="Top commitments by supplier and article"
                           Kpis="@ContractKpis"
                           ChartRows="@ContractChartRows"
                           StatusRows="@ContractStatusRows"
                           DetailRows="@ContractDetailRows" />
        break;
    case "lieferanten":
        <PurchasingSection TitleDe="Lieferanten und Bestellpreise"
                           TitleEn="Suppliers and order prices"
                           DescriptionDe="Lieferanten aus EKKO.LIFNR mit Bestellpositionen EKPO, Namen aus LFA1.NAME1. Bestellpreise aus EKPO.NETWR / EKPO.MENGE in CHF. Liefertreue und Qualitaet werden mangels angebundener Ist-Wareneingangs- und Reklamationsdaten nicht bewertet."
                           DescriptionEn="Suppliers from EKKO.LIFNR with EKPO order items, names from LFA1.NAME1. Order prices from EKPO.NETWR / EKPO.MENGE in CHF. Delivery reliability and quality are not rated because actual receipt and claim data are not connected."
                           ChartTitleDe="Top Lieferanten nach Spend im gewaehlten Zeitraum"
                           ChartTitleEn="Top suppliers by spend in the selected period"
                           Kpis="@SupplierKpis"
                           ChartRows="@SupplierChartRows"
                           StatusRows="@SupplierStatusRows"
                           DetailRows="@SupplierDetailRows" />
        break;
    case "aufriss":
        <PurchasingSpendExplorer SpendYears="@_liveState.SpendYears"
                                 Perspectives="@_liveState.SpendPerspectiveRows"
                                 CascadeRows="@_liveState.SpendCascadeRows"
                                 ProductGroupAllocation="@_liveState.ProductGroupAllocation"
                                 RegionGroups="@_liveState.RegionByMaterialGroupRows"
                                 AbcRows="@_liveState.AbcSpendRows"
                                 XyzRows="@_liveState.XyzSpendRows"
                                 AbcXyzActionRows="@_liveState.AbcXyzActionRows" />
        break;
    case "ideen":
        <MudGrid Spacing="2">
            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-3 purchasing-overview-panel" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <div>
                            <MudText Typo="Typo.h6">@T("Weitere Einkaufsanalysen", "Additional purchasing analytics")</MudText>
                            <MudText Typo="Typo.body2" Class="purchasing-muted">
                                @T("Analysen, die dem Einkauf neben PowerBI mehr Steuerung, Risiko- und Sparpotenzial zeigen.",
                                   "Analytics that give purchasing more steering, risk and savings potential beyond Power BI.")
                            </MudText>
                        </div>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                            @T("Roadmap", "Roadmap")
                        </MudChip>
                    </MudStack>
                    <div class="purchasing-idea-grid">
                        @foreach (var idea in PurchasingIdeas)
                        {
                            <div class="purchasing-idea-card">
                                <div class="purchasing-idea-icon">
                                    <MudIcon Icon="@idea.Icon" Color="@idea.Color" />
                                </div>
                                <div class="purchasing-idea-content">
                                    <div class="purchasing-idea-title">
                                        <strong>@T(idea.TitleDe, idea.TitleEn)</strong>
                                        <MudChip T="string" Size="Size.Small" Color="@idea.Color" Variant="Variant.Outlined">@T(idea.StatusDe, idea.StatusEn)</MudChip>
                                    </div>
                                    <span>@T(idea.DescriptionDe, idea.DescriptionEn)</span>
                                    <div class="purchasing-idea-meta">
                                        <code>@idea.RequiredData</code>
                                        <span>@T("Nutzen", "Value"): @T(idea.ValueDe, idea.ValueEn)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-3 purchasing-overview-panel" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-2">@T("Prioritaet", "Priority")</MudText>
                    <div class="purchasing-priority-stack">
                        @foreach (var priority in PurchasingIdeaPriorities)
                        {
                            <div class="purchasing-priority-row">
                                <MudIcon Icon="@priority.Icon" Color="@priority.Color" Size="Size.Small" />
                                <div>
                                    <strong>@T(priority.TitleDe, priority.TitleEn)</strong>
                                    <span>@T(priority.DetailDe, priority.DetailEn)</span>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="pa-3 purchasing-overview-panel" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <div>
                            <MudText Typo="Typo.h6">@T("Ideen ausgearbeitet", "Ideas worked out")</MudText>
                            <MudText Typo="Typo.body2" Class="purchasing-muted">
                                @T("Jede Idee ist als aufklappbarer Ausbau-Baustein beschrieben.",
                                   "Each idea is described as an expandable build-out block.")
                            </MudText>
                        </div>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@PurchasingIdeaWorkPackages.Count @T("Bausteine", "blocks")</MudChip>
                    </MudStack>
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="purchasing-idea-expansion">
                        @foreach (var package in PurchasingIdeaWorkPackages)
                        {
                            <MudExpansionPanel>
                                <TitleContent>
                                    <div class="purchasing-idea-panel-title">
                                        <MudIcon Icon="@package.Icon" Color="@package.Color" />
                                        <div>
                                            <strong>@T(package.TitleDe, package.TitleEn)</strong>
                                            <span>@T(package.ShortDe, package.ShortEn)</span>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="@package.Color" Variant="Variant.Outlined">@T(package.StatusDe, package.StatusEn)</MudChip>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="6">
                                            <div class="purchasing-idea-detail-block">
                                                <MudText Typo="Typo.subtitle2">@T("Ziel", "Goal")</MudText>
                                                <span>@T(package.GoalDe, package.GoalEn)</span>
                                            </div>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <div class="purchasing-idea-detail-block">
                                                <MudText Typo="Typo.subtitle2">@T("Datenbasis", "Data basis")</MudText>
                                                <code>@package.DataBasis</code>
                                            </div>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
