    private string LatestAverageUnitPriceLabel
    {
        get
        {
            var rows = _liveState.PriceVarianceChartRows;
            if (!_liveState.EkpoLoaded || rows.Count == 0)
                return "-";
            var current = rows[^1].Value;
            var label = $"CHF {current:N2}";
            // Der reine Preisstand mischt Schrauben und Baugruppen und ist als Niveau wenig wert;
            // erst die Veraenderung gegenueber dem Vorjahr ist eine Aussage. Beides zusammen,
            // damit der Wert zum Label "CHF/Stk" passt und trotzdem eine Richtung zeigt.
            if (rows.Count < 2 || rows[^2].Value <= 0m)
                return label;
            var change = (current - rows[^2].Value) / rows[^2].Value * 100m;
            return $"{label} ({change:+0.0;-0.0;0.0}%)";
        }
    }

