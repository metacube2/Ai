    private static string BuildDefaultFromMonth()
    {
        return "2020-01";
    }

    private static string BuildDefaultToMonth()
        => DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);

    private PurchasingDashboardFilter BuildCurrentFilter()
    {
        var from = ParseMonth(_filterFromMonth, new DateTime(DateTime.Today.Year - 2, 1, 1));
        var toMonth = ParseMonth(_filterToMonth, DateTime.Today);
        var to = new DateTime(toMonth.Year, toMonth.Month, DateTime.DaysInMonth(toMonth.Year, toMonth.Month));
        var minFrom = new DateTime(2020, 1, 1);
        if (from < minFrom)
            from = minFrom;

        if (to < from)
            from = new DateTime(to.Year, 1, 1);

        if (to > DateTime.Today)
            to = DateTime.Today;

        if (to.Year > 2026)
            to = new DateTime(2026, 12, 31);

        return new PurchasingDashboardFilter(from, to, _excludeDeletedItems);
    }

    private static DateTime ParseMonth(string value, DateTime fallback)
        => DateTime.TryParseExact(value, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? new DateTime(parsed.Year, parsed.Month, 1)
            : fallback;

    private DateTime? GetFilterFromDate() => ParseMonth(_filterFromMonth, new DateTime(2020, 1, 1));
    private DateTime? GetFilterToDate() => ParseMonth(_filterToMonth, DateTime.Today);

    private Task OnFilterFromDateChangedAsync(DateTime? date)
    {
        if (date.HasValue)
            _filterFromMonth = date.Value.ToString("yyyy-MM", CultureInfo.InvariantCulture);

        // MudDatePicker feuert beim Navigieren/Setzen eines Monats. Das Cockpit aggregiert
        // dabei den gesamten Einkaufs-Cache; die Auswahl darf deshalb noch keinen Ladevorgang
        // ausloesen. Beide Monate koennen zuerst gesetzt und danach bewusst angewendet werden.
        return Task.CompletedTask;
    }

    private Task OnFilterToDateChangedAsync(DateTime? date)
    {
        if (date.HasValue)
            _filterToMonth = date.Value.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        return Task.CompletedTask;
    }

    private static string ClampMonth(string value)
    {
        var parsed = ParseMonth(value, DateTime.Today);
        if (parsed < new DateTime(2020, 1, 1))
            parsed = new DateTime(2020, 1, 1);
        if (parsed > DateTime.Today)
            parsed = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        if (parsed.Year > 2026)
            parsed = new DateTime(2026, 12, 1);
        return parsed.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    }

