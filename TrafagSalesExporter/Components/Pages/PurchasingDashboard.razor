    default:
        <MudGrid Spacing="2">
            @* Lagerwert-Verlauf je Woche. Wunsch aus dem Einkauf vom September 2026, von Marco
               bestaetigt: ab Verfuegbarkeit erfassen und spaeter den Trend ablesen. Kein
               rueckwirkender Verlauf aus MBEWH (siehe docs/EINKAUF_LAGERWERT_2026-08-18.md). *@
            <MudItem xs="12">
                <MudPaper Class="pa-3 purchasing-overview-panel" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                        <div>
                            <MudText Typo="Typo.h6">@T("Lagerwert Einkaufsteile: Verlauf je Woche", "Purchased parts stock value: weekly trend")</MudText>
                            <MudText Typo="Typo.body2" Class="purchasing-muted">
                                @T("Stand Ende Kalenderwoche aus dem taeglichen Einkauf-Lauf, Disponenten", "End-of-week value from the daily purchasing run, planners") @string.Join("/", TrafagSalesExporter.Services.PurchasingDashboardService.PurchasingPlanners).
                                @* Startdatum aus den Daten, nicht fest im Text: der erste Punkt ist der beim
                                   Deploy gespeicherte Kachelstand und kann aelter sein als der Deploy. *@
                                @if (_liveState.StockValueWeeklyHistory.Count > 0)
                                {
                                    @($"{T("Erster Verlaufspunkt:", "First trend point:")} {_liveState.StockValueWeeklyHistory[0].SnapshotDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)}. ")
                                }
                                @T("Fruehere Wochen gibt es nicht. Wochen ohne Lauf bleiben leer. Der Wert ist noch nicht gegen MB5L abgeglichen.", "Earlier weeks do not exist. Weeks without a run stay empty. The value has not yet been reconciled with MB5L.")
                            </MudText>
                        </div>
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">@_liveState.StockValueWeeklyHistory.Count @T("Wochen", "weeks")</MudChip>
                    </MudStack>
                    @if (_liveState.StockValueWeeklyHistory.Count < 2)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            @(_liveState.StockValueWeeklyHistory.Count == 0
                                ? T("Noch kein Verlaufspunkt. Der erste entsteht mit dem naechsten Einkauf-Lauf.", "No trend point yet. The first one is created by the next purchasing run.")
                                : T("Der Verlauf beginnt. Eine Linie entsteht ab der zweiten Woche.", "The trend has started. A line appears from the second week."))
                        </MudAlert>
                    }
                    else
                    {
                        <div style="overflow-x:auto">
                            @BuildStockTrendSvg()
                        </div>
                        <MudText Typo="Typo.caption" Class="purchasing-muted d-block mb-2">
                            @T("Die Hochachse beginnt nicht bei null, sondern beim tiefsten Wert, damit Veraenderungen sichtbar sind.", "The vertical axis starts at the lowest value, not at zero, so that changes are visible.")
                        </MudText>
                    }
                    @if (_liveState.StockValueWeeklyHistory.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto">
                            <thead><tr>
                                <th>@T("Kalenderwoche", "Calendar week")</th>
                                <th>@T("Stand vom", "Value as of")</th>
                                <th style="text-align:right">@T("Lagerwert", "Stock value")</th>
                                <th style="text-align:right">@T("Veraenderung zur Vorwoche", "Change vs. previous week")</th>
                                <th style="text-align:right">@T("Materialien", "Materials")</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var row in StockTrendTableRows)
                                {
                                    <tr>
                                        <td>@row.Week</td>
                                        <td>@row.Date</td>
                                        <td style="text-align:right">@FormatChf(row.Value)</td>
                                        <td style="text-align:right">@row.Change</td>
                                        <td style="text-align:right">@row.MaterialCount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-3 purchasing-overview-panel" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <div>
                            <MudText Typo="Typo.h6">@T("SAP Datenfluss", "SAP data flow")</MudText>
                            <MudText Typo="Typo.body2" Class="purchasing-muted">@T("Vom OData-Service bis zur Kennzahl sichtbar, welcher Baustein echt ist.", "From OData service to KPI, it is visible which block is real.")</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@DataReadinessText</MudChip>
                    </MudStack>
                    <div class="purchasing-pipeline">
                        @foreach (var step in PipelineRows)
                        {
                            <div class="purchasing-pipeline-step @(step.IsReady ? "is-ready" : "is-waiting")">
                                <MudIcon Icon="@step.Icon" Color="@step.Color" />
                                <div>
                                    <strong>@T(step.TitleDe, step.TitleEn)</strong>
                                    <span>@T(step.DetailDe, step.DetailEn)</span>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@step.Color" Variant="Variant.Outlined">@step.Value</MudChip>
                            </div>
                        }
                    </div>
                </MudPaper>
