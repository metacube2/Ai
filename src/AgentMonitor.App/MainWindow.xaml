<Window x:Class="AgentMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentMonitor.App"
        Title="Agenten-Monitor" Width="620" Height="820" MinWidth="340" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="12.5" TextOptions.TextFormattingMode="Ideal"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1B1C21"/>
        <SolidColorBrush x:Key="Card" Color="#25272E"/>
        <SolidColorBrush x:Key="CardInner" Color="#2C2F37"/>
        <SolidColorBrush x:Key="Line" Color="#3A3D47"/>
        <SolidColorBrush x:Key="Text" Color="#E8E9ED"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9DA8"/>
        <SolidColorBrush x:Key="Thinking" Color="#A78BFA"/>
        <SolidColorBrush x:Key="Working" Color="#60A5FA"/>
        <SolidColorBrush x:Key="Waiting" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Done" Color="#34D399"/>
        <SolidColorBrush x:Key="Failed" Color="#F87171"/>
        <SolidColorBrush x:Key="Idle" Color="#6B7080"/>

        <!-- Farbe je Phase, gebunden an PhaseKey -->
        <Style x:Key="PhaseBrush" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PhaseKey}" Value="Thinking"><Setter Property="Background" Value="{StaticResource Thinking}"/></DataTrigger>
                <DataTrigger Binding="{Binding PhaseKey}" Value="Working"><Setter Property="Background" Value="{StaticResource Working}"/></DataTrigger>
                <DataTrigger Binding="{Binding PhaseKey}" Value="Waiting"><Setter Property="Background" Value="{StaticResource Waiting}"/></DataTrigger>
                <DataTrigger Binding="{Binding PhaseKey}" Value="Done"><Setter Property="Background" Value="{StaticResource Done}"/></DataTrigger>
                <DataTrigger Binding="{Binding PhaseKey}" Value="Failed"><Setter Property="Background" Value="{StaticResource Failed}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Prozentbalken je Agent (echter Fortschritt aus der Aufgabenliste): Zahl im Balken, weicher Lauf
             (BarAnimation), Schimmer bis 100 %. -->
        <Style x:Key="PercentBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="15"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Done}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="7.5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7.5" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2BB989" Offset="0"/>
                                        <GradientStop Color="#34D399" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Rectangle x:Name="Shimmer" RadiusX="7.5" RadiusY="7.5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="ShimmerShift" X="-1"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#00FFFFFF" Offset="0.30"/>
                                            <GradientStop Color="#66FFFFFF" Offset="0.50"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.70"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X"
                                                                     From="-1" To="1" Duration="0:0:1.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"
                                       Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0} %}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" Color="Black"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="100">
                                <Setter TargetName="Shimmer" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Balken je Aktion: laufend ein wandernder Lichtstreifen (es gibt keinen echten Prozentwert je Aktion,
             deshalb keine Zahl), fertig voll gruen, Fehler rot. -->
        <Style x:Key="ActionBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Done}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}"/>
                            <Rectangle x:Name="Runner" RadiusX="2" RadiusY="2" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="RunnerShift" X="-1"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#0060A5FA" Offset="0.20"/>
                                        <GradientStop Color="#FF60A5FA" Offset="0.45"/>
                                        <GradientStop Color="#FFBFDBFE" Offset="0.50"/>
                                        <GradientStop Color="#FF60A5FA" Offset="0.55"/>
                                        <GradientStop Color="#0060A5FA" Offset="0.80"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X"
                                                                 From="-1" To="1" Duration="0:0:1.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                    <Setter Property="IsIndeterminate" Value="True"/>
                    <Setter Property="Foreground" Value="{StaticResource Working}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Failed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Done}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Running"><Setter Property="Foreground" Value="{StaticResource Working}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource Failed}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <!-- Vergroesserung der ganzen Anzeige (Strg+Mausrad, Strg+Plus/Minus, Strg+0, Tray-Menue) -->
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="1.4" ScaleY="1.4"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile, zum Verschieben -->
            <Grid Grid.Row="0" Margin="12,8,8,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ActivityDot" Width="9" Height="9" Fill="{StaticResource Idle}" Margin="0,0,8,0"/>
                    <TextBlock Text="Agenten-Monitor" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13.5"/>
                    <TextBlock x:Name="HeaderInfo" Foreground="{StaticResource Muted}" Margin="10,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Click="PinButton_Click" Content="&#x1F4CC;"/>
                    <Button Style="{StaticResource HeaderButton}" Click="HideButton_Click" ToolTip="Ausblenden (Tray)" Content="&#x2715;"/>
                </StackPanel>
            </Grid>

            <!-- Sitzungen -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,4,0">
                <Grid>
                    <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,20"
                               Text="Noch keine Aktivität. Sobald eine Claude-Code-Sitzung arbeitet, erscheint sie hier."/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" CornerRadius="8" Margin="0,0,4,8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,6"/>

                                        <ItemsControl ItemsSource="{Binding Agents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardInner}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Style="{StaticResource PhaseBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PhaseText}" Foreground="#15161A" FontWeight="SemiBold" FontSize="11"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Elapsed}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Waiting}" FontSize="11" Margin="0,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource Done}" FontSize="11.5" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LastMessage}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Echter Fortschritt aus der Aufgabenliste -->
                                                            <Grid Margin="0,6,0,2" Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Style="{StaticResource PercentBar}" local:BarAnimation.Value="{Binding Progress, Mode=OneWay}"
                                                                             VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <!-- Aktionen, neueste oben -->
                                                            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,3,0,1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="18"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontFamily="Segoe UI Symbol"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Tool}" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
                                                                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                                                            </Grid>
                                                                            <!-- Das „Wie“: genauer Befehl, Ordner usw. -->
                                                                            <TextBlock Text="{Binding Detail}" Foreground="#7F8391" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                                                                       Margin="18,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <ProgressBar Style="{StaticResource ActionBar}" Margin="18,2,0,0"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="18,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding HiddenActions, StringFormat='+ {0} ältere Aktionen'}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HiddenActions}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Fusszeile -->
            <TextBlock x:Name="Footer" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,4,24,8" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
