<Window x:Class="VideoDoku.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video-Doku" Width="1300" Height="1000" MinWidth="700" MinHeight="500"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" PreviewMouseWheel="Window_PreviewMouseWheel">

    <Grid>
        <!-- Vergroesserung (Strg+Mausrad), Standard 130 % -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1.3" ScaleY="1.3"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Quelle -->
        <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="8" Margin="10,10,10,6" Padding="12,10">
            <StackPanel>
                <TextBlock Text="1. Quelle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="PowerPoint wählen …" Click="PickPowerPoint_Click"/>
                        <Button Content="Skript wählen …" Click="PickScript_Click"/>
                        <Button Content="Beispiel-Skript anlegen …" Click="CreateSample_Click"/>
                    </StackPanel>
                    <TextBox x:Name="SourcePath" IsReadOnly="True" VerticalContentAlignment="Center"
                             Text="PowerPoint (.pptx) oder Skript (.txt) wählen oder hierher ziehen"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 2. Einstellungen -->
        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="8" Margin="10,0,10,6" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="2. Stimme und Ausgabe" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Text="Stimme" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
                <!-- Standard-Optik von Windows (hell), dunkle Schrift: gut lesbar -->
                <ComboBox x:Name="VoiceBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="6,4" Foreground="#111216" FontSize="13"
                          SelectionChanged="VoiceBox_SelectionChanged"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Stimmen neu laden" Click="ReloadVoices_Click" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="2" Text="Schlüssel" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <TextBlock x:Name="KeyState" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <PasswordBox x:Name="KeyBox" ToolTip="Schlüssel „video-doku“ für tts.ingok.ch. Wird mit Windows verschlüsselt gespeichert."/>
                </DockPanel>
                <Button Grid.Row="2" Grid.Column="2" Content="Schlüssel speichern" Click="SaveKey_Click" Margin="8,2,0,2"/>

                <TextBlock Grid.Row="3" Text="Musik" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="MusicPath" Grid.Row="3" Grid.Column="1" Margin="0,2" IsReadOnly="True" Text="(keine)"/>
                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="8,2,0,2">
                    <Button Content="wählen …" Click="PickMusic_Click"/>
                    <Button Content="entfernen" Click="RemoveMusic_Click" Margin="0"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Ausgabe" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <CheckBox x:Name="SubtitlesBox" Content="Untertitel" IsChecked="True"/>
                        <CheckBox x:Name="KenBurnsBox" Content="sanfter Bildzoom" IsChecked="True"/>
                    </StackPanel>
                    <TextBox x:Name="OutputPath" VerticalContentAlignment="Center"/>
                </DockPanel>
                <Button Grid.Row="4" Grid.Column="2" Content="Speichern unter …" Click="PickOutput_Click" Margin="8,2,0,2"/>
            </Grid>
        </Border>

        <!-- 3. Szenen -->
        <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="8" Margin="10,0,10,6" Padding="12,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="SceneInfo" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Text="3. Szenen (Text hier noch anpassbar)" FontWeight="SemiBold" FontSize="14"/>
                </DockPanel>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,10"
                               Text="Noch keine Szenen. Wähle oben eine PowerPoint-Datei (die Sprechernotizen werden zum Text) oder ein Skript für eine freie Doku."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SceneList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardInner}" CornerRadius="6" Margin="0,0,6,6" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="192"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="192" Height="108" Background="#111216" CornerRadius="4" VerticalAlignment="Top">
                                                <Grid>
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" FontSize="11"
                                                               VerticalAlignment="Bottom" Margin="4,0,4,2" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CharInfo}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                                         MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Height="14" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="{StaticResource Failed}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12"
                                                               Margin="10,0,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 4. Erstellen -->
        <Border Grid.Row="3" Background="{StaticResource Card}" CornerRadius="8" Margin="10,0,10,10" Padding="12,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="OverallBar" Style="{StaticResource Bar}" Height="20" Tag=""/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                               MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BuildButton" Style="{StaticResource Primary}" Content="Video erstellen" Click="Build_Click" IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" IsEnabled="False"/>
                    <Button x:Name="OpenVideoButton" Content="Video abspielen" Click="OpenVideo_Click" IsEnabled="False"/>
                    <Button x:Name="OpenFolderButton" Content="Ordner öffnen" Click="OpenFolder_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
