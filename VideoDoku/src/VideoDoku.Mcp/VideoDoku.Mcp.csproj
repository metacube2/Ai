<Project Sdk="Microsoft.NET.Sdk">

  <!-- MCP-Server (stdio), damit eine KI das Video-Werkzeug vollstaendig bedienen kann. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VideoDokuMcp</AssemblyName>
    <RootNamespace>VideoDoku.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoDoku.Core\VideoDoku.Core.csproj" />
    <ProjectReference Include="..\VideoDoku.Windows\VideoDoku.Windows.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

</Project>
